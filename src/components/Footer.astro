---
import { site } from '@data/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-sage-100 bg-cream-300/40">
  <div class="container-page py-12 sm:py-16">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 sm:gap-10 text-sm">

      <!-- Col 1: Yahyr -->
      <div>
        <h3 class="font-display font-bold text-ink-300 mb-3 text-xs uppercase tracking-wider">Yahyr</h3>
        <ul class="space-y-2">
          <li><a href="/sobre-mi" class="text-ink-200 hover:text-ink-300 transition-colors">Sobre mí</a></li>
          <li><a href="/perfil" class="text-ink-200 hover:text-ink-300 transition-colors">Perfil profesional</a></li>
          <li><a href="/contacto" class="text-ink-200 hover:text-ink-300 transition-colors">Contacto</a></li>
        </ul>
      </div>

      <!-- Col 2: Servicios -->
      <div>
        <h3 class="font-display font-bold text-ink-300 mb-3 text-xs uppercase tracking-wider">Servicios</h3>
        <ul class="space-y-2">
          <li><a href="/servicios/webs" class="text-ink-200 hover:text-ink-300 transition-colors">Webs de alto rendimiento</a></li>
          <li><a href="/servicios/apps" class="text-ink-200 hover:text-ink-300 transition-colors">Apps móviles</a></li>
          <li><a href="/servicios/ecosistema" class="text-ink-200 hover:text-ink-300 transition-colors">Ecosistema completo</a></li>
          <li><a href="/servicios/hot-fixes" class="text-ink-200 hover:text-ink-300 transition-colors">Hot fixes</a></li>
          <li><a href="/servicios/ai-rescue" class="text-ink-200 hover:text-ink-300 transition-colors">AI Rescue</a></li>
        </ul>
      </div>

      <!-- Col 3: Plugins -->
      <div>
        <h3 class="font-display font-bold text-ink-300 mb-3 text-xs uppercase tracking-wider">Tiger Suite</h3>
        <ul class="space-y-2">
          {site.plugins.map((p) => (
            <li><a href={`/plugins/${p.slug}`} class="text-ink-200 hover:text-ink-300 transition-colors">{p.name.replace('Tiger ', '')}</a></li>
          ))}
          <li class="pt-1"><a href="/plugins" class="text-sage-500 font-medium hover:text-sage-600">Ver suite completa →</a></li>
        </ul>
      </div>

      <!-- Col 4: Recursos -->
      <div>
        <h3 class="font-display font-bold text-ink-300 mb-3 text-xs uppercase tracking-wider">Recursos</h3>
        <ul class="space-y-2">
          <li><a href="/blog" class="text-ink-200 hover:text-ink-300 transition-colors">Blog</a></li>
          <li><a href="/sitemap-index.xml" class="text-ink-200 hover:text-ink-300 transition-colors">Mapa del sitio</a></li>
          <li><a href="/llms.txt" class="text-ink-200 hover:text-ink-300 transition-colors">LLM-friendly content</a></li>
          <li><a href="/robots.txt" class="text-ink-200 hover:text-ink-300 transition-colors">robots.txt</a></li>
        </ul>
      </div>

      <!-- Col 5: Conecta -->
      <div>
        <h3 class="font-display font-bold text-ink-300 mb-3 text-xs uppercase tracking-wider">Conecta</h3>
        <ul class="space-y-2">
          {site.socials.map((s) => (
            <li>
              <a
                href={s.url}
                target={s.url.startsWith('http') ? '_blank' : undefined}
                rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="text-ink-200 hover:text-ink-300 transition-colors"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-sage-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-100">
      <p>© {year} {site.name} · Hecho en {site.location}, {site.country}</p>
      <p class="flex items-center gap-3">
        <a href="mailto:{site.email}" class="hover:text-ink-300 transition-colors">{site.email}</a>
        <span class="text-sage-200">·</span>
        <span>Built with Astro</span>
      </p>
    </div>
  </div>
</footer>
