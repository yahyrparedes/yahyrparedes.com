---
import { site } from '@data/site.ts';
import { t, getLangFromUrl } from '@i18n/ui.ts';
import LanguageToggle from './LanguageToggle.astro';
import '@styles/global.css';

const currentLang = getLangFromUrl(Astro.url);
const year = new Date().getFullYear();

const navItems = [
  { key: 'nav.home', href: currentLang === 'en' ? '/en/' : '/es/' },
  { key: 'nav.about', href: currentLang === 'en' ? '/en/behind-the-engineer' : '/es/sobre-mi' },
  { key: 'nav.experience', href: currentLang === 'en' ? '/en/experience' : '/es/experience' },
  { key: 'nav.services', href: currentLang === 'en' ? '/en/services' : '/es/servicios' },
  { key: 'nav.open_source', href: currentLang === 'en' ? '/en/open-source' : '/es/plugins' },
  { key: 'nav.contact', href: currentLang === 'en' ? '/en/contact' : '/es/contacto' },
];

const serviceItems = [
  { key: 'footer.service_web', href: currentLang === 'en' ? '/en/services/webs' : '/es/servicios/webs' },
  { key: 'footer.service_apps', href: currentLang === 'en' ? '/en/services/apps' : '/es/servicios/apps' },
  { key: 'footer.service_ecosystem', href: currentLang === 'en' ? '/en/services/ecosistema' : '/es/servicios/ecosistema' },
  { key: 'footer.service_hotfixes', href: currentLang === 'en' ? '/en/services/hot-fixes' : '/es/servicios/hot-fixes' },
  { key: 'footer.service_rescue', href: currentLang === 'en' ? '/en/services/ai-rescue' : '/es/servicios/ai-rescue' },
];

const legalItems = [
  { key: 'footer.legal_privacy', href: currentLang === 'en' ? '/en/privacy' : '/es/privacidad' },
  { key: 'footer.legal_terms', href: currentLang === 'en' ? '/en/terms' : '/es/aviso-legal' },
  { key: 'footer.legal_cookies', href: currentLang === 'en' ? '/en/cookies' : '/es/cookies' },
];

const socials = [
  { name: 'GitHub', href: site.socials.find(s => s.icon === 'github')?.url || 'https://github.com/yahyrparedes', icon: 'github' },
  { name: 'LinkedIn', href: site.socials.find(s => s.icon === 'linkedin')?.url || 'https://linkedin.com/in/yahyrparedes', icon: 'linkedin' },
  { name: 'Twitter', href: 'https://twitter.com/yahyr_paredes', icon: 'twitter' },
  { name: 'Email', href: `mailto:${site.email}`, icon: 'email' },
];
---

<footer class="mt-24 border-t border-border">
  <div class="container-page py-16 sm:py-20">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">

      <!-- Col 1: Brand + available -->
      <div class="lg:col-span-4">
        <div class="flex items-center gap-3 mb-6">
          <img
            src="/images/logo.png"
            alt={site.name}
            class="w-11 h-11 rounded-full object-cover ring-1 ring-border"
            width="44"
            height="44"
            loading="lazy"
          />
          <div class="leading-tight">
            <p class="font-display font-bold text-base text-ink">{site.name.toUpperCase()}</p>
            <p class="text-xs text-blue-200 font-medium">{site.role}</p>
          </div>
        </div>

        <p class="text-ink-100 text-sm leading-relaxed mb-3">
          {t(Astro.url, 'footer.tagline')}
        </p>
        <p class="text-ink-200 text-xs mb-6">
          {t(Astro.url, 'footer.location')}
        </p>

        <!-- Available for work pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-green/30 bg-green/10">
          <span class="w-1.5 h-1.5 rounded-full bg-green animate-pulse" aria-hidden="true"></span>
          <span class="text-xs font-semibold text-green">{t(Astro.url, 'footer.available')}</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="lg:col-span-2">
        <h3 class="font-display font-semibold text-ink mb-4 text-sm uppercase tracking-wider">
          {t(Astro.url, 'footer.col_nav')}
        </h3>
        <ul class="space-y-2.5 text-sm">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="text-ink-200 hover:text-ink transition-colors">
                {t(Astro.url, item.key)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Services + Legal -->
      <div class="lg:col-span-2">
        <h3 class="font-display font-semibold text-ink mb-4 text-sm uppercase tracking-wider">
          {t(Astro.url, 'footer.col_services')}
        </h3>
        <ul class="space-y-2.5 text-sm">
          {serviceItems.map((item) => (
            <li>
              <a href={item.href} class="text-ink-200 hover:text-ink transition-colors">
                {t(Astro.url, item.key)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Legal + Stay in the loop -->
      <div class="lg:col-span-4">
        <h3 class="font-display font-semibold text-ink mb-4 text-sm uppercase tracking-wider">
          {t(Astro.url, 'footer.col_newsletter')}
        </h3>
        <p class="text-ink-200 text-sm mb-3">
          {t(Astro.url, 'footer.col_newsletter_body')}
        </p>
        <form class="mb-6" onsubmit="event.preventDefault();">
          <div class="flex gap-2">
            <input
              type="email"
              placeholder={t(Astro.url, 'footer.col_newsletter_placeholder')}
              class="flex-1 px-3 py-2 rounded-lg bg-midnight-100 border border-border text-sm text-ink placeholder:text-ink-300 focus:border-blue-200 focus:outline-none transition-colors"
              aria-label="Email"
            />
            <button
              type="submit"
              class="px-3 py-2 rounded-lg bg-midnight-200 border border-border text-ink-200 hover:text-ink hover:border-blue-200 transition-colors"
              aria-label="Subscribe"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </form>

        <h4 class="font-display font-semibold text-ink mb-3 text-xs uppercase tracking-wider">
          {t(Astro.url, 'footer.col_legal')}
        </h4>
        <ul class="space-y-2 text-sm">
          {legalItems.map((item) => (
            <li>
              <a href={item.href} class="text-ink-200 hover:text-ink transition-colors">
                {t(Astro.url, item.key)}
              </a>
            </li>
          ))}
        </ul>

        <!-- Social icons -->
        <div class="mt-6 flex items-center gap-2">
          {socials.map((social) => (
            <a
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-midnight-100 border border-border text-ink-200 hover:text-ink hover:border-blue-200 transition-colors"
              aria-label={social.name}
            >
              {social.icon === 'github' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              )}
              {social.icon === 'linkedin' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              )}
              {social.icon === 'twitter' && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              )}
              {social.icon === 'email' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              )}
            </a>
          ))}
        </div>

        <div class="mt-4">
          <LanguageToggle />
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-ink-300">
      <p>{t(Astro.url, 'footer.copyright').replace('2026', String(year))}</p>
      <p class="text-ink-200">{t(Astro.url, 'footer.built_with')}</p>
    </div>
  </div>
</footer>
