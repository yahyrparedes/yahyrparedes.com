---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath } from '@i18n/ui.ts';
import { yearsOfExperience } from '@data/career.ts';

const lang = getLangFromUrl(Astro.url);
const years = yearsOfExperience();
const experienceUrl = getLocalizedPath('experience', lang);

const copy = lang === 'en'
  ? {
      title: 'About me',
      description: 'Peruvian software engineer based in Jaén, Spain. Android first, backend and cloud after: how I got here and how I work.',
      h1: 'Peruvian engineer, Android first, backend by choice.',
      intro: [
        `I trained in Telematics in Lima and shipped my first Android app in 2016. Over ${years} years I have gone from native apps to Go, Java and Python services in the cloud, working for startups, agencies and large companies in insurance, food & beverage, logistics and retail.`,
        'Since December 2025 I live in Jaén, Spain, where I worked remotely as the Android engineer for the Starbucks Peru app. Today I am looking for my next team, as an Android or backend engineer.',
      ],
      facts: [
        { label: 'Based in', value: 'Jaén, Spain' },
        { label: 'Work permit', value: 'Authorized to work in Spain' },
        { label: 'Languages', value: 'Spanish (native), English (B1)' },
        { label: 'Availability', value: 'Immediate · remote, hybrid or on-site' },
      ],
      photoAlt: 'Yahyr Paredes working at his desk',
      pathTitle: 'How I got here',
      path: [
        { year: '2014 – 2016', title: 'Telematics at IBEROTEC / IDAT', body: 'Networking, programming, microcontrollers and IoT. My first internship was in the institute’s systems team.' },
        { year: '2016 – 2019', title: 'Android, from developer to tech lead', body: 'Urbaner, Intercorp, ESAN, Force Close and Avances Tecnológicos. I shipped apps to the stores and, as mobile tech lead, mentored two juniors.' },
        { year: '2019 – 2021', title: 'E-commerce and logistics', body: 'Tech lead for Calzado Atlas’ digital transformation, then Android and Go for Urbaner’s courier platform.' },
        { year: '2021 – 2024', title: 'Backend, IoT and teaching', body: 'Kwema (US), Groway Studio, where I also taught microservices and Docker, Silabuz and Interseguro, where I helped introduce Go.' },
        { year: '2024 – 2026', title: 'Starbucks Peru', body: 'I rewrote the Starbucks Rewards Android app (1M+ downloads) in Kotlin, Compose and KMP.' },
        { year: 'Dec 2025', title: 'New home in Spain', body: 'I moved to Jaén with my family and kept working remotely.' },
      ],
      principlesTitle: 'How I work',
      principles: [
        { title: 'Production is the goal', body: 'Shipping is not the finish line. I care about what happens after release: monitoring, security hardening and releases the team can repeat every month.' },
        { title: 'Migrate without breaking', body: 'Most of my work has been evolving systems that were already live: SOAT from PHP to Go, a legacy Android app to Kotlin, a full platform from Azure to AWS.' },
        { title: 'Leave the team better', body: 'Go templates other teams adopted, commit and README standards, mentoring juniors and teaching. Knowledge that stays when I leave.' },
        { title: 'Mobile and backend are one product', body: 'Having worked on both sides, I design APIs thinking about the app that consumes them, and apps thinking about the services behind them.' },
      ],
      teamAlt: 'Yahyr with his development team in Lima',
      teamCaption: 'With my development team in Lima.',
      interestsTitle: 'What I am exploring',
      interests: [
        { title: 'Security', body: 'App hardening, ethical hacking and secure-by-default backends.' },
        { title: 'AI applied to development', body: 'Claude Code, Cursor and Copilot, with tests and reviews that keep the output honest.' },
        { title: 'Kotlin Multiplatform', body: 'Shared business logic with native UIs on Android and iOS.' },
        { title: 'Open source', body: 'Small tools such as Flow-GM and modules for e-commerce stores.' },
      ],
      ctaTitle: 'Looking for an Android or backend engineer?',
      ctaBody: 'I am available now for remote, hybrid or on-site roles in Spain.',
      ctaPrimary: 'See my experience',
      ctaSecondary: 'Contact me',
    }
  : {
      title: 'Sobre mí',
      description: 'Ingeniero de software peruano afincado en Jaén, España. Primero Android, después backend y cloud: cómo llegué aquí y cómo trabajo.',
      h1: 'Ingeniero peruano, Android de origen, backend por elección.',
      intro: [
        `Me formé en Telemática en Lima y publiqué mi primera app Android en 2016. En ${years} años he pasado de las apps nativas a servicios en Go, Java y Python en la nube, trabajando para startups, agencias y grandes empresas de seguros, restauración, logística y retail.`,
        'Desde diciembre de 2025 vivo en Jaén, España, donde trabajé en remoto como ingeniero Android de la app de Starbucks Perú. Ahora busco mi próximo equipo, como ingeniero Android o backend.',
      ],
      facts: [
        { label: 'Ubicación', value: 'Jaén, España' },
        { label: 'Permiso de trabajo', value: 'Autorización para trabajar en España' },
        { label: 'Idiomas', value: 'Español (nativo), inglés (B1)' },
        { label: 'Disponibilidad', value: 'Inmediata · remoto, híbrido o presencial' },
      ],
      photoAlt: 'Yahyr Paredes trabajando en su escritorio',
      pathTitle: 'Cómo llegué hasta aquí',
      path: [
        { year: '2014 – 2016', title: 'Telemática en IBEROTEC / IDAT', body: 'Redes, programación, microcontroladores e IoT. Mis primeras prácticas fueron en el equipo de sistemas del instituto.' },
        { year: '2016 – 2019', title: 'Android, de desarrollador a líder técnico', body: 'Urbaner, Intercorp, ESAN, Force Close y Avances Tecnológicos. Publiqué apps en las tiendas y, como líder técnico móvil, formé a dos desarrolladores junior.' },
        { year: '2019 – 2021', title: 'E-commerce y logística', body: 'Líder técnico de la transformación digital de Calzado Atlas y después Android y Go en la plataforma de courier de Urbaner.' },
        { year: '2021 – 2024', title: 'Backend, IoT y docencia', body: 'Kwema (EE. UU.), Groway Studio, donde también enseñé microservicios y Docker, Silabuz e Interseguro, donde ayudé a introducir Go.' },
        { year: '2024 – 2026', title: 'Starbucks Perú', body: 'Reescribí la app Android de Starbucks Rewards (más de 1M de descargas) en Kotlin, Compose y KMP.' },
        { year: 'dic 2025', title: 'Nuevo hogar en España', body: 'Me mudé a Jaén con mi familia y seguí trabajando en remoto.' },
      ],
      principlesTitle: 'Cómo trabajo',
      principles: [
        { title: 'La meta es producción', body: 'Publicar no es la línea de meta. Me importa lo que pasa después: monitorización, seguridad y releases que el equipo pueda repetir cada mes.' },
        { title: 'Migrar sin romper', body: 'Gran parte de mi trabajo ha sido evolucionar sistemas que ya estaban en producción: el SOAT de PHP a Go, una app Android heredada a Kotlin y una plataforma entera de Azure a AWS.' },
        { title: 'Dejar al equipo mejor', body: 'Templates de Go que adoptaron otros equipos, estándares de commits y README, mentoring a juniors y docencia. Conocimiento que se queda cuando me voy.' },
        { title: 'Mobile y backend, un solo producto', body: 'Como he trabajado en los dos lados, diseño APIs pensando en la app que las consume, y apps pensando en los servicios que hay detrás.' },
      ],
      teamAlt: 'Yahyr con su equipo de desarrollo en Lima',
      teamCaption: 'Con mi equipo de desarrollo en Lima.',
      interestsTitle: 'Lo que estoy explorando',
      interests: [
        { title: 'Seguridad', body: 'Hardening de apps, hacking ético y backends seguros por defecto.' },
        { title: 'IA aplicada al desarrollo', body: 'Claude Code, Cursor y Copilot, con tests y revisiones que mantienen el resultado bajo control.' },
        { title: 'Kotlin Multiplatform', body: 'Lógica de negocio compartida con interfaces nativas en Android e iOS.' },
        { title: 'Open source', body: 'Herramientas pequeñas como Flow-GM y módulos para tiendas e-commerce.' },
      ],
      ctaTitle: '¿Buscas un ingeniero Android o backend?',
      ctaBody: 'Estoy disponible ya para roles en remoto, híbridos o presenciales en España.',
      ctaPrimary: 'Ver mi experiencia',
      ctaSecondary: 'Escríbeme',
    };
---

<BaseLayout title={copy.title} description={copy.description} type="profile">
  <section class="hero-editorial relative overflow-hidden">
    <div class="container-page relative grid items-center gap-10 pt-16 pb-14 sm:pt-20 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-5">{copy.title}</p>
        <h1 class="mb-6 text-balance">{copy.h1}</h1>
        {copy.intro.map((p) => <p class="mb-4 max-w-[62ch] text-lg leading-relaxed text-ink-100">{p}</p>)}
        <dl class="about-facts mt-8">
          {copy.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="lg:col-span-5">
        <figure class="about-portrait">
          <img src="/images/portrait.jpg" alt={copy.photoAlt} width="620" height="775" loading="eager" />
        </figure>
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20" aria-labelledby="path-title">
    <h2 id="path-title" class="mb-10 text-balance">{copy.pathTitle}</h2>
    <ol class="about-path">
      {copy.path.map((step) => (
        <li>
          <p class="about-path-year">{step.year}</p>
          <div>
            <h3 class="font-display text-lg font-bold text-ink">{step.title}</h3>
            <p class="mt-1.5 max-w-[68ch] leading-relaxed text-ink-200">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <a href={experienceUrl} class="mt-8 inline-flex text-sm font-semibold text-blue-200 hover:text-ink">{copy.ctaPrimary}</a>
  </section>

  <section class="border-y border-border bg-carbon/40" aria-labelledby="principles-title">
    <div class="container-page grid gap-10 py-16 sm:py-20 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="principles-title" class="mb-8 text-balance">{copy.principlesTitle}</h2>
        <figure class="about-team">
          <img src="/images/team-lima.jpg" alt={copy.teamAlt} width="1200" height="900" loading="lazy" />
          <figcaption>{copy.teamCaption}</figcaption>
        </figure>
      </div>
      <div class="grid content-start gap-4 sm:grid-cols-2 lg:col-span-7">
        {copy.principles.map((p) => (
          <article class="about-principle">
            <h3 class="font-display text-lg font-bold text-ink">{p.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-200">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20" aria-labelledby="interests-title">
    <h2 id="interests-title" class="mb-8 text-balance">{copy.interestsTitle}</h2>
    <ul class="grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
      {copy.interests.map((i) => (
        <li class="border-t border-border pt-4">
          <h3 class="font-display text-lg font-bold text-ink">{i.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-200">{i.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-border">
    <div class="container-page py-12 sm:py-16">
      <div class="closing-panel card-glass flex flex-col items-start justify-between gap-6 p-8 sm:flex-row sm:items-center sm:p-10">
        <div>
          <h2 class="text-2xl sm:text-3xl text-balance">{copy.ctaTitle}</h2>
          <p class="mt-2 text-ink-200">{copy.ctaBody}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={experienceUrl} class="btn btn-primary">{copy.ctaPrimary}</a>
          <a href={getLocalizedPath('contact', lang)} class="btn btn-outline">{copy.ctaSecondary}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-facts { display: grid; gap: 1rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr)); max-width: 40rem; }
  .about-facts dt { font-size: 0.8rem; color: var(--color-ink-300); }
  .about-facts dd { margin-top: 0.15rem; font-weight: 600; color: var(--color-ink); }
  .about-portrait {
    margin: 0 auto;
    max-width: 26rem;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }
  .about-portrait img { display: block; width: 100%; height: auto; }

  .about-path { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--color-border); }
  .about-path li {
    position: relative;
    display: grid;
    gap: 0.35rem;
    padding: 0 0 2rem 1.5rem;
  }
  .about-path li::before {
    content: '';
    position: absolute;
    left: -0.35rem;
    top: 0.45rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: var(--color-blue);
    box-shadow: 0 0 0 4px var(--color-midnight);
  }
  .about-path li:last-child { padding-bottom: 0; }
  .about-path li:last-child::before { background: var(--color-success); }
  .about-path-year { font-family: var(--font-heading); font-size: 0.9rem; font-weight: 600; color: var(--color-blue-soft); font-variant-numeric: tabular-nums; }
  @media (min-width: 768px) {
    .about-path { border-left: 0; }
    .about-path li { grid-template-columns: 9rem 1fr; gap: 2rem; padding: 0; }
    .about-path li::before { left: 10.65rem; }
    .about-path li > div { border-left: 1px solid var(--color-border); padding: 0 0 2rem 2rem; }
    .about-path li:last-child > div { padding-bottom: 0; }
    .about-path-year { text-align: right; padding-top: 0.1rem; }
  }

  .about-team { margin: 0; }
  .about-team img { display: block; width: 100%; height: auto; border-radius: 1rem; border: 1px solid var(--color-border); }
  .about-team figcaption { margin-top: 0.6rem; font-size: 0.85rem; color: var(--color-ink-300); }
  .about-principle { border: 1px solid var(--color-border); border-radius: 1rem; background: var(--color-carbon); padding: 1.5rem; }
</style>
