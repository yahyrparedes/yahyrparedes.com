---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site.ts';
import { t, getLangFromUrl } from '@i18n/ui.ts';

const currentLang = getLangFromUrl(Astro.url);

const principles = [
  { num: '01', titleKey: 'about.principle_1_title', bodyKey: 'about.principle_1_body' },
  { num: '02', titleKey: 'about.principle_2_title', bodyKey: 'about.principle_2_body' },
  { num: '03', titleKey: 'about.principle_3_title', bodyKey: 'about.principle_3_body' },
  { num: '04', titleKey: 'about.principle_4_title', bodyKey: 'about.principle_4_body' },
];

const timeline = [
  { yearKey: 'about.story_1_year', labelKey: 'about.story_1_label', bodyKey: 'about.story_1_body' },
  { yearKey: 'about.story_2_year', labelKey: 'about.story_2_label', bodyKey: 'about.story_2_body' },
  { yearKey: 'about.story_3_year', labelKey: 'about.story_3_label', bodyKey: 'about.story_3_body' },
  { yearKey: 'about.story_4_year', labelKey: 'about.story_4_label', bodyKey: 'about.story_4_body' },
  { yearKey: 'about.story_5_year', labelKey: 'about.story_5_label', bodyKey: 'about.story_5_body' },
];

const inspirations = [
  { nameKey: 'about.inspires_travel', icon: 'travel' },
  { nameKey: 'about.inspires_photography', icon: 'photography' },
  { nameKey: 'about.inspires_security', icon: 'security' },
  { nameKey: 'about.inspires_coffee', icon: 'coffee' },
  { nameKey: 'about.inspires_family', icon: 'family' },
  { nameKey: 'about.inspires_open_source', icon: 'open_source' },
];
---

<BaseLayout title={t(Astro.url, 'about.eyebrow') + ' · ' + site.name} description={t(Astro.url, 'about.subheadline')} type="profile">
  <section class="container-page pt-16 sm:pt-20 pb-12">
    <p class="eyebrow mb-5">{t(Astro.url, 'about.eyebrow')}</p>
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <h1 class="text-balance mb-6">
          {t(Astro.url, 'about.title_start')}{' '}
          <span class="font-display italic text-ink font-medium">{t(Astro.url, 'about.title_strong')}</span>
          {t(Astro.url, 'about.title_end')}
        </h1>
        <p class="text-ink-100 text-lg sm:text-xl max-w-2xl leading-relaxed mb-6">{t(Astro.url, 'about.subheadline')}</p>
        <div class="flex flex-wrap gap-4 text-sm text-ink-200">
          <div class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-blue-200" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{t(Astro.url, 'about.location')}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-blue-200" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
            </svg>
            <span>{t(Astro.url, 'about.remote')}</span>
          </div>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="relative aspect-square max-w-md mx-auto">
          <div class="absolute -top-4 -left-4 w-20 h-20 rounded-full bg-blue/20 -z-10" aria-hidden="true"></div>
          <img src="/images/personal-3.png" alt={site.name} class="relative w-full h-full object-cover rounded-3xl ring-1 ring-border" width="500" height="500" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-midnight-100/30">
    <div class="container-page py-12 sm:py-16">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-5">
          <p class="eyebrow mb-3">{t(Astro.url, 'about.journey_eyebrow')}</p>
          <h2 class="text-balance mb-4">
            {t(Astro.url, 'about.journey_title_start')}{' '}
            <span class="text-blue-200 font-display italic font-medium">{t(Astro.url, 'about.journey_peru')}</span>{' '}
            {t(Astro.url, 'about.journey_to')}{' '}
            <span class="text-blue-200 font-display italic font-medium">{t(Astro.url, 'about.journey_spain')}</span>
            {t(Astro.url, 'about.journey_title_end')}
          </h2>
          <p class="text-ink-200 leading-relaxed">{t(Astro.url, 'about.journey_body')}</p>
        </div>

        <div class="lg:col-span-7">
          <div class="relative">
            <div class="hidden md:block absolute top-1/2 left-0 right-0 h-px bg-blue/30 -translate-y-1/2"></div>
            <div class="grid grid-cols-2 md:grid-cols-2 gap-6">
              <div class="text-center md:text-left">
                <p class="font-display font-bold text-2xl text-blue-200 mb-1">{t(Astro.url, 'about.journey_step1_year')}</p>
                <p class="font-display font-bold text-base text-ink">{t(Astro.url, 'about.journey_step1_label')}</p>
                <p class="text-xs text-ink-300 mt-1">Perú</p>
              </div>
              <div class="text-center md:text-left">
                <p class="font-display font-bold text-2xl text-blue-200 mb-1">{t(Astro.url, 'about.journey_step2_year')}</p>
                <p class="font-display font-bold text-base text-ink">{t(Astro.url, 'about.journey_step2_label')}</p>
                <p class="text-xs text-ink-300 mt-1">España</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="mb-12 max-w-2xl">
      <p class="eyebrow mb-3">{t(Astro.url, 'about.principles_eyebrow')}</p>
      <h2 class="text-balance">
        {t(Astro.url, 'about.principles_title_start')}{' '}
        <span class="text-blue-200 font-display italic font-medium">{t(Astro.url, 'about.principles_title_strong')}</span>
        {t(Astro.url, 'about.principles_title_end')}
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 sm:gap-5">
      {principles.map((p) => (
        <div class="card p-6 sm:p-8">
          <p class="font-display font-bold text-3xl text-blue-200 mb-4">{p.num}</p>
          <h3 class="font-display font-bold text-lg text-ink mb-3">{t(Astro.url, p.titleKey)}</h3>
          <p class="text-ink-200 text-sm leading-relaxed">{t(Astro.url, p.bodyKey)}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-y border-border bg-midnight-100/30">
    <div class="container-page py-16 sm:py-20">
      <div class="mb-12 max-w-2xl">
        <p class="eyebrow mb-3">{t(Astro.url, 'about.story_eyebrow')}</p>
        <h2 class="text-balance">{t(Astro.url, 'about.story_title')}</h2>
      </div>
      <div class="relative">
        <div class="absolute left-0 md:left-32 top-0 bottom-0 w-px bg-blue/30"></div>
        <div class="space-y-12">
          {timeline.map((item) => (
            <div class="relative pl-8 md:pl-48">
              <div class="absolute left-0 md:left-32 top-2 -translate-x-1/2 w-3 h-3 rounded-full bg-blue ring-4 ring-midnight"></div>
              <div class="md:absolute md:left-0 md:top-0 md:w-32 md:text-right">
                <p class="font-display font-bold text-sm text-blue-200">{t(Astro.url, item.yearKey)}</p>
              </div>
              <div class="md:ml-0">
                <p class="font-display font-bold text-lg text-ink mb-2">{t(Astro.url, item.labelKey)}</p>
                <p class="text-ink-200 text-sm leading-relaxed">{t(Astro.url, item.bodyKey)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="mb-12 max-w-2xl">
      <p class="eyebrow mb-3">{t(Astro.url, 'about.inspires_eyebrow')}</p>
      <h2 class="text-balance">
        {t(Astro.url, 'about.inspires_title_start')}{' '}
        <span class="text-blue-200 font-display italic font-medium">{t(Astro.url, 'about.inspires_title_strong')}</span>
        {t(Astro.url, 'about.inspires_title_end')}
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
      {inspirations.map((item) => (
        <div class="card aspect-square flex flex-col items-center justify-center p-4 group hover:border-blue/30">
          <div class="w-10 h-10 mb-3 text-blue-200 group-hover:text-blue transition-colors" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              {item.icon === 'travel' && <><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></>}
              {item.icon === 'photography' && <><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></>}
              {item.icon === 'security' && <><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></>}
              {item.icon === 'coffee' && <><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4z"/><path d="M6 1v3M10 1v3M14 1v3"/></>}
              {item.icon === 'family' && <><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></>}
              {item.icon === 'open_source' && <><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></>}
            </svg>
          </div>
          <p class="font-display font-semibold text-sm text-ink text-center">{t(Astro.url, item.nameKey)}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-y border-border bg-midnight-100/30">
    <div class="container-page py-16 sm:py-20">
      <p class="eyebrow mb-10">{t(Astro.url, 'about.outside_eyebrow')}</p>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card p-6">
          <p class="text-xs text-blue-200 uppercase tracking-wider mb-2">{t(Astro.url, 'about.outside_reading')}</p>
          <p class="font-display font-bold text-base text-ink">Atomic Habits</p>
          <p class="text-xs text-ink-200 mt-1">James Clear</p>
        </div>
        <div class="card p-6">
          <p class="text-xs text-blue-200 uppercase tracking-wider mb-2">{t(Astro.url, 'about.outside_listening')}</p>
          <p class="font-display font-bold text-base text-ink">Lex Fridman Podcast</p>
          <p class="text-xs text-ink-200 mt-1">#380</p>
        </div>
        <div class="card p-6">
          <p class="text-xs text-blue-200 uppercase tracking-wider mb-2">{t(Astro.url, 'about.outside_learning')}</p>
          <p class="font-display font-bold text-base text-ink">Rust</p>
          <p class="text-xs text-ink-200 mt-1">Systems programming</p>
        </div>
        <div class="card p-6">
          <p class="text-xs text-blue-200 uppercase tracking-wider mb-2">{t(Astro.url, 'about.outside_exploring')}</p>
          <p class="font-display font-bold text-base text-ink">AI Agents</p>
          <p class="text-xs text-ink-200 mt-1">Next frontier</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16 sm:py-24">
    <div class="max-w-3xl mx-auto text-center">
      <p class="font-display italic text-3xl sm:text-4xl text-ink leading-snug mb-6">&ldquo;{t(Astro.url, 'about.why_title_strong')}&rdquo;</p>
      <p class="text-ink-200 leading-relaxed mb-8">{t(Astro.url, 'about.why_body')}</p>
      <p class="font-display italic text-blue-200">— {site.name}</p>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="container-page py-12 sm:py-16">
      <div class="card p-8 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-center sm:text-left">
          <h2 class="text-2xl sm:text-3xl text-balance">
            {t(Astro.url, 'about.cta_title_start')}{' '}
            <span class="text-blue-200 font-display italic font-medium">{t(Astro.url, 'about.cta_title_strong')}</span>
            {t(Astro.url, 'about.cta_title_end')}
          </h2>
          <p class="text-ink-200 mt-2">{t(Astro.url, 'about.cta_body')}</p>
        </div>
        <a href={currentLang === 'en' ? '/en/experience' : '/es/experience'} class="btn btn-primary flex-shrink-0">
          {t(Astro.url, 'about.cta_button')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
