---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site.ts';
import { getLangFromUrl, getLocalizedPath } from '@i18n/ui.ts';
import {
  roles,
  companies,
  education,
  certifications,
  languages,
  skillGroups,
  formatPeriod,
  yearsOfExperience,
} from '@data/career.ts';

const lang = getLangFromUrl(Astro.url);
const years = yearsOfExperience();
const linkedin = site.socials.find((s) => s.icon === 'linkedin')?.url ?? '';
const github = site.socials.find((s) => s.icon === 'github')?.url ?? '';

const copy = lang === 'en'
  ? {
      title: 'CV',
      description: `CV of Yahyr Paredes: Android & backend engineer with ${years}+ years of experience. Kotlin, Go, Java, Python, AWS and GCP.`,
      headline: 'Senior Software Engineer · Android & backend',
      location: 'Jaén, Spain · Authorized to work in Spain',
      summary: `Software engineer with ${years}+ years of experience and a strong Android base (Kotlin, Jetpack Compose, KMP), plus solid backend and cloud work (Go, Java/Spring, Python/Django, AWS, GCP). I have shipped products in food & beverage, insurance, logistics, e-commerce, IoT and retail. Until August 2026 I owned the Starbucks Peru Android app (1M+ downloads), working remotely from Spain. I am now looking for my next role as an Android or backend engineer.`,
      available: 'Available now · remote, hybrid or on-site in Spain',
      print: 'Save as PDF',
      experience: 'Experience',
      skills: 'Skills',
      education: 'Education',
      certs: 'Certifications and courses',
      langs: 'Languages',
      inProgress: 'in progress',
      fullStory: 'Full story with context and links',
      contact: 'Contact',
    }
  : {
      title: 'CV',
      description: `CV de Yahyr Paredes: ingeniero Android y backend con más de ${years} años de experiencia. Kotlin, Go, Java, Python, AWS y GCP.`,
      headline: 'Senior Software Engineer · Android y backend',
      location: 'Jaén, España · Autorización para trabajar en España',
      summary: `Ingeniero de software con más de ${years} años de experiencia, con base fuerte en Android (Kotlin, Jetpack Compose, KMP) y experiencia sólida en backend y cloud (Go, Java/Spring, Python/Django, AWS, GCP). He llevado productos a producción en restauración, seguros, logística, e-commerce, IoT y retail. Hasta agosto de 2026 fui responsable de la app Android de Starbucks Perú (más de 1M de descargas), en remoto desde España. Ahora busco mi próximo reto como ingeniero Android o backend.`,
      available: 'Disponible · incorporación inmediata · remoto, híbrido o presencial en España',
      print: 'Guardar como PDF',
      experience: 'Experiencia',
      skills: 'Habilidades',
      education: 'Formación',
      certs: 'Certificaciones y cursos',
      langs: 'Idiomas',
      inProgress: 'en curso',
      fullStory: 'Historia completa con contexto y enlaces',
      contact: 'Contacto',
    };
---

<BaseLayout title={copy.title} description={copy.description} type="profile">
  <article class="cv container-page max-w-4xl py-12 sm:py-16">
    <header class="cv-header">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="flex items-center gap-4">
          <img src="/images/logo.png" alt="" width="72" height="72" class="cv-photo h-[72px] w-[72px] rounded-full object-cover ring-1 ring-border" />
          <div>
            <h1 class="font-display text-3xl font-bold leading-tight text-ink sm:text-4xl">Yahyr Enrique Paredes Arteaga</h1>
            <p class="mt-1 text-lg text-blue-200">{copy.headline}</p>
          </div>
        </div>
        <button type="button" class="btn btn-outline cv-no-print" data-print>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"/></svg>
          {copy.print}
        </button>
      </div>
      <p class="cv-available mt-5"><span aria-hidden="true"></span>{copy.available}</p>
      <ul class="cv-contact mt-4">
        <li>{copy.location}</li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/yahyrparedes</a></li>
        <li><a href={github} target="_blank" rel="noopener noreferrer">github.com/yahyrparedes</a></li>
        <li><a href="https://yahyrparedes.com">yahyrparedes.com</a></li>
      </ul>
      <p class="mt-6 max-w-[72ch] leading-relaxed text-ink-100">{copy.summary}</p>
    </header>

    <section class="cv-section" aria-labelledby="cv-exp">
      <div class="cv-section-head">
        <h2 id="cv-exp">{copy.experience}</h2>
        <a href={getLocalizedPath('experience', lang)} class="cv-no-print text-sm font-semibold text-blue-200 hover:text-ink">{copy.fullStory}</a>
      </div>
      <ol class="space-y-7">
        {roles.map((role) => {
          const c = companies[role.companyId];
          const isGroup = role.companyId === 'previous';
          return (
            <li class="cv-role" style={`--brand:${c.color}`}>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-display text-lg font-bold text-ink">
                  {isGroup ? (lang === 'en' ? 'Earlier experience: Android & mobile' : 'Experiencia previa: Android y mobile') : `${role.title[lang]}, ${c.name}`}
                </h3>
                <p class="text-sm tabular-nums text-ink-200">{formatPeriod(role, lang)}</p>
              </div>
              <p class="text-sm text-ink-300">
                {isGroup ? role.group?.map((g) => g.company).join(', ') : `${role.location[lang]} · ${role.employment[lang]}`}
              </p>
              <ul class="cv-bullets mt-2.5">
                {role.highlights[lang].slice(0, isGroup ? 3 : 4).map((h) => <li>{h}</li>)}
              </ul>
              <p class="mt-2 text-xs text-ink-300">{role.stack.slice(0, 9).join(', ')}</p>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="cv-skills">
      <div class="cv-section-head"><h2 id="cv-skills">{copy.skills}</h2></div>
      <dl class="grid gap-4 sm:grid-cols-2">
        {skillGroups.map((g) => (
          <div>
            <dt class="text-sm font-semibold text-ink">{g.name[lang]}</dt>
            <dd class="mt-1 text-sm leading-relaxed text-ink-200">{g.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="grid gap-x-10 sm:grid-cols-2">
      <section class="cv-section" aria-labelledby="cv-edu">
        <div class="cv-section-head"><h2 id="cv-edu">{copy.education}</h2></div>
        {education.map((e) => (
          <div>
            <h3 class="font-display text-lg font-bold text-ink">{e.title[lang]}</h3>
            <p class="text-sm text-ink-200">{e.school} · {e.period} · {e.location[lang]}</p>
            <p class="mt-1.5 text-sm text-ink-200">{e.note[lang]}</p>
          </div>
        ))}
        <div class="mt-8">
          <h2 id="cv-langs" class="cv-h2-small">{copy.langs}</h2>
          <ul class="mt-2 space-y-1 text-sm text-ink-200">
            {languages.map((l) => <li><span class="font-semibold text-ink">{l.name[lang]}</span>: {l.level[lang]}</li>)}
          </ul>
        </div>
      </section>

      <section class="cv-section" aria-labelledby="cv-certs">
        <div class="cv-section-head"><h2 id="cv-certs">{copy.certs}</h2></div>
        <ul class="space-y-2 text-sm">
          {certifications.map((c) => (
            <li class="text-ink-200">
              <span class="font-semibold text-ink">{c.name}</span>
              {(c.issuer || c.year || c.inProgress) && (
                <span>{' '}({[c.issuer, c.year, c.inProgress ? copy.inProgress : ''].filter(Boolean).join(', ')})</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="cv-no-print mt-14 flex flex-wrap gap-3">
      <a href={getLocalizedPath('contact', lang)} class="btn btn-primary">{copy.contact}</a>
      <a href={getLocalizedPath('experience', lang)} class="btn btn-outline">{copy.fullStory}</a>
    </div>
  </article>
</BaseLayout>

<style>
  .cv-available { display: inline-flex; align-items: center; gap: 0.5rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--color-success) 40%, transparent); background: color-mix(in srgb, var(--color-success) 10%, transparent); padding: 0.3rem 0.85rem; font-size: 0.85rem; font-weight: 600; color: var(--color-success); }
  .cv-available span { width: 0.45rem; height: 0.45rem; border-radius: 999px; background: currentColor; }
  .cv-contact { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; font-size: 0.9rem; color: var(--color-ink-200); }
  .cv-contact a { color: var(--color-ink-100); text-decoration: underline; text-decoration-color: var(--color-border); text-underline-offset: 3px; }
  .cv-contact a:hover { color: var(--color-ink); text-decoration-color: currentColor; }
  .cv-section { margin-top: 3rem; }
  .cv-section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.6rem;
  }
  .cv-section-head h2, .cv-h2-small { font-size: 1.35rem; }
  .cv-h2-small { border-bottom: 1px solid var(--color-border); padding-bottom: 0.6rem; }
  .cv-role { border-left: 3px solid var(--brand); padding-left: 1rem; break-inside: avoid; }
  .cv-bullets { display: grid; gap: 0.35rem; list-style: disc; padding-left: 1.1rem; font-size: 0.92rem; line-height: 1.55; color: var(--color-ink-200); }
  .cv-bullets li::marker { color: var(--brand); }

  @media print {
    @page { margin: 14mm 14mm; }
    :global(html) { font-size: 9.5pt; color-scheme: light !important; }
    .cv-header > p { font-size: 1rem !important; }
    :global(*), :global(*::before), :global(*::after) { background: transparent !important; }
    :global(html), :global(body) { background: #fff !important; color: #111 !important; }
    .cv-bullets li:nth-child(n + 4) { display: none; }
    .cv-role + .cv-role { margin-top: 0.9rem !important; }
    .cv-header p { margin-top: 0.8rem !important; }
    :global(.site-header), :global(footer), .cv-no-print { display: none !important; }
    .cv { padding: 0 !important; max-width: none !important; }
    .cv :global(*) { color: #111 !important; box-shadow: none !important; }
    .cv a { text-decoration: none !important; }
    .cv-photo { display: none; }
    .cv-section { margin-top: 1.4rem; }
    .cv-section-head, .cv-h2-small { border-color: #ccc !important; }
    .cv-role { border-left-color: #999 !important; }
  }
</style>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
