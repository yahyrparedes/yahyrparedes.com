---

<BaseLayout title={copy.title} description={copy.description}>
  <section class="bg-hero py-12 sm:py-20">
    <div class="container-page">
      <p class="eyebrow mb-5">{copy.eyebrow}</p>
      <h1 class="text-balance max-w-3xl mb-6">
        {copy.hero1}<br />
        {copy.hero2}<br />
        {copy.hero3} <span class="text-blue-200 font-display italic font-medium">{copy.heroStrong}</span>.
      </h1>
      <p class="text-ink-100 text-lg max-w-2xl leading-relaxed">{copy.intro}</p>
    </div>
  </section>

  <section class="container-page py-12 sm:py-16">
    <div class="space-y-6">
      {copy.entries.map((exp) => (
        <article class="card overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
            <!-- Left: logo + company + year + body -->
            <div class="lg:col-span-4 p-6 sm:p-8 lg:border-r lg:border-border flex flex-col">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg bg-midnight-200 flex items-center justify-center flex-shrink-0">
                  <span class="text-xs font-display font-bold text-blue-200 uppercase">{exp.company.charAt(0)}</span>
                </div>
                <div>
                  <p class="font-display font-bold text-sm text-ink">{exp.company}</p>
                  <span class="inline-block text-[10px] px-2 py-0.5 rounded-full bg-blue/10 text-blue-200 border border-blue/30 mt-1">{exp.companyTag}</span>
                </div>
              </div>
              <p class="font-display font-bold text-2xl text-blue-200 mb-3">{exp.year}</p>
              <p class="text-ink-100 leading-relaxed mb-4">{exp.title}</p>
              <a href={exp.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-200 hover:text-blue transition-colors mt-auto">
                {currentLang === 'en' ? 'Visit website' : 'Visitar sitio'}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
              </a>
            </div>

            <!-- Middle: my role + impact + technologies -->
            <div class="lg:col-span-4 p-6 sm:p-8 lg:border-r lg:border-border">
              <p class="text-xs text-ink-300 uppercase tracking-wider mb-2">{copy.myRole}</p>
              <p class="font-display font-bold text-base text-ink mb-5">{exp.role}</p>

              <p class="text-xs text-ink-300 uppercase tracking-wider mb-2">{copy.impact}</p>
              <ul class="space-y-1.5 mb-5">
                {exp.impact.map((point) => (
                  <li class="flex items-start gap-2 text-sm text-ink-200">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-blue-200 flex-shrink-0 mt-1" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              <p class="text-xs text-ink-300 uppercase tracking-wider mb-2">{copy.technologies}</p>
              <div class="flex flex-wrap gap-1.5">
                {exp.technologies.map((tech) => (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-midnight-200 text-ink-200">{tech}</span>
                ))}
              </div>
            </div>

            <!-- Right: product screenshot -->
            <div class="lg:col-span-4 p-6 sm:p-8 flex items-center justify-center bg-midnight-200/30">
              <img src={exp.image} alt={exp.company} class="max-w-full max-h-48 rounded-lg ring-1 ring-border shadow-soft object-contain" loading="lazy" />
            </div>
          </div>

          <!-- Recommended by: full width below -->
          <div class="border-t border-border p-6 sm:p-8 bg-midnight-200/20">
            <p class="text-xs text-ink-300 uppercase tracking-wider mb-3">{copy.recommendedBy}</p>
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-blue/20 flex items-center justify-center flex-shrink-0">
                <span class="text-sm font-display font-bold text-blue-200">{exp.recommended.author.charAt(0)}</span>
              </div>
              <div class="flex-1">
                <blockquote class="text-sm text-ink-100 italic leading-relaxed mb-2">&ldquo;{exp.recommended.quote}&rdquo;</blockquote>
                <p class="text-xs text-ink-300"><span class="font-semibold text-ink-200">{exp.recommended.author}</span> · {exp.recommended.role}</p>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-border">
    <div class="container-page py-12 sm:py-16">
      <div class="card p-8 sm:p-10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="text-center sm:text-left">
          <p class="font-display italic text-2xl sm:text-3xl text-ink mb-2">
            {copy.finalTitle} <span class="text-blue-200">{copy.finalStrong}</span>
          </p>
          <p class="text-ink-200 text-sm">{copy.finalBody}</p>
        </div>
        <a href={currentLang === 'en' ? '/en/contact' : '/es/contacto'} class="btn btn-primary flex-shrink-0">
          {copy.cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
