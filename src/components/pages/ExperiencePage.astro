---
import BaseLayout from '@layouts/BaseLayout.astro';
import CareerGraph from '@components/CareerGraph.astro';
import { getLangFromUrl, getLocalizedPath } from '@i18n/ui.ts';
import {
  roles,
  companies,
  formatPeriod,
  formatDuration,
  yearsOfExperience,
  isTestimonialVisible,
  type Track,
} from '@data/career.ts';

const lang = getLangFromUrl(Astro.url);
const years = yearsOfExperience();
const VISIBLE_HIGHLIGHTS = 3;

const copy = lang === 'en'
  ? {
      title: 'Experience',
      description: `${years} years building Android apps and backends in production: Starbucks Peru, Interseguro, Kwema, Urbaner and more.`,
      h1: `${years} years shipping apps and backends that people use every day.`,
      intro: 'From my first Android apps in Lima to owning the Starbucks Peru app from Spain. Every role below links to the products, the stack and what changed thanks to the work.',
      graphTitle: 'At a glance',
      graphHint: 'Click a bar to jump to that role.',
      filterLabel: 'Filter by area',
      all: 'All',
      showMore: (n: number) => `Show ${n} more`,
      showLess: 'Show less',
      about: 'About the company',
      stack: 'Stack',
      recommended: 'Recommendation',
      draft: 'Draft · not published',
      companiesTitle: 'Companies in this period',
      empty: 'No roles in this area.',
      ctaTitle: 'Want the short version?',
      ctaBody: 'The CV page has the same story on one page, with education, certifications and languages.',
      ctaCv: 'See my CV',
      ctaContact: 'Contact me',
      present: 'Current',
      early: 'Early career',
    }
  : {
      title: 'Experiencia',
      description: `${years} años construyendo apps Android y backends en producción: Starbucks Perú, Interseguro, Kwema, Urbaner y más.`,
      h1: `${years} años creando apps y backends que la gente usa a diario.`,
      intro: 'De mis primeras apps Android en Lima a ser responsable de la app de Starbucks Perú desde España. Cada rol enlaza a los productos, el stack y lo que cambió gracias al trabajo.',
      graphTitle: 'De un vistazo',
      graphHint: 'Pulsa una barra para ir a ese rol.',
      filterLabel: 'Filtrar por área',
      all: 'Todo',
      showMore: (n: number) => `Ver ${n} más`,
      showLess: 'Ver menos',
      about: 'Sobre la empresa',
      stack: 'Stack',
      recommended: 'Recomendación',
      draft: 'Borrador · no publicado',
      companiesTitle: 'Empresas en esta etapa',
      empty: 'No hay roles en esta área.',
      ctaTitle: '¿Prefieres la versión corta?',
      ctaBody: 'La página de CV tiene esta misma historia en una sola página, con formación, certificaciones e idiomas.',
      ctaCv: 'Ver mi CV',
      ctaContact: 'Escríbeme',
      present: 'Actual',
      early: 'Primeros años',
    };

const filters: { id: Track | 'all'; label: string }[] = [
  { id: 'all', label: copy.all },
  { id: 'mobile', label: 'Mobile' },
  { id: 'backend', label: 'Backend' },
  { id: 'fullstack', label: 'Full stack' },
  { id: 'cloud', label: 'Cloud' },
  { id: 'lead', label: lang === 'en' ? 'Leadership' : 'Liderazgo' },
];
---

<BaseLayout title={copy.title} description={copy.description} type="profile">
  <section class="hero-editorial relative overflow-hidden">
    <div class="container-page relative pt-16 pb-12 sm:pt-24 sm:pb-16">
      <p class="eyebrow mb-5">{copy.title}</p>
      <h1 class="max-w-4xl text-balance">{copy.h1}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-100">{copy.intro}</p>
    </div>
  </section>

  <section class="container-page pb-6" aria-labelledby="graph-title">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="graph-title" class="text-xl sm:text-2xl">{copy.graphTitle}</h2>
      <p class="text-sm text-ink-200">{copy.graphHint}</p>
    </div>
    <CareerGraph lang={lang} inPage />
  </section>

  <section class="container-page py-12 sm:py-16" aria-label={copy.title}>
    <div class="exp-filters mb-10" role="group" aria-label={copy.filterLabel} data-exp-filters>
      {filters.map((f, i) => (
        <button type="button" class="exp-filter" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}
        </button>
      ))}
    </div>

    <ol class="exp-list" data-exp-list>
      {roles.map((role) => {
        const company = companies[role.companyId];
        const extra = role.highlights[lang].slice(VISIBLE_HIGHLIGHTS);
        const testimonial = isTestimonialVisible(role.testimonial) ? role.testimonial : undefined;
        const isGroup = role.companyId === 'previous';
        return (
          <li id={role.id} class="exp-item" data-tracks={role.tracks.join(' ')} style={`--brand:${company.color}`}>
            <div class="exp-when">
              <p class="exp-period">{formatPeriod(role, lang)}</p>
              <p class="exp-duration">{formatDuration(role, lang)}</p>
            </div>
            <div class="exp-rail" aria-hidden="true"><span class:list={['exp-dot', { 'is-current': !role.end }]}></span></div>

            <article class="exp-card">
              <header class="flex items-start gap-4">
                <div class="exp-logo">
                  {company.mark
                    ? <img src={company.mark} alt="" width="40" height="40" loading="lazy" />
                    : <span>{isGroup ? '</>' : company.name.charAt(0)}</span>}
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-xl font-bold leading-snug text-ink">
                    {isGroup ? role.title[lang] : company.name}
                    {company.context && <span class="ml-1.5 text-sm font-medium text-ink-200">{company.context[lang]}</span>}
                  </h3>
                  <p class="mt-1 text-[0.95rem] text-ink-100">{isGroup ? copy.early : role.title[lang]}</p>
                  <p class="mt-1 text-sm text-ink-200">
                    {role.employment[lang]}, {role.location[lang]}
                    <span class="exp-period-inline"><br />{formatPeriod(role, lang)} ({formatDuration(role, lang)})</span>
                    {!role.end && <span class="exp-badge">{copy.present}</span>}
                  </p>
                </div>
              </header>

              <p class="mt-5 leading-relaxed text-ink-100">{role.summary[lang]}</p>

              <ul class="exp-highlights mt-4">
                {role.highlights[lang].slice(0, VISIBLE_HIGHLIGHTS).map((h) => <li>{h}</li>)}
              </ul>
              {extra.length > 0 && (
                <details class="exp-more">
                  <summary>
                    <span class="when-closed">{copy.showMore(extra.length)}</span>
                    <span class="when-open">{copy.showLess}</span>
                  </summary>
                  <ul class="exp-highlights">
                    {extra.map((h) => <li>{h}</li>)}
                  </ul>
                </details>
              )}

              {role.group && (
                <div class="mt-6">
                  <h4 class="mb-3 text-sm font-semibold text-ink">{copy.companiesTitle}</h4>
                  <ul class="grid gap-3 sm:grid-cols-2">
                    {role.group.map((g) => (
                      <li class="rounded-xl border border-border bg-white/[0.03] p-4">
                        <p class="flex items-baseline justify-between gap-3">
                          <span class="font-semibold text-ink">{g.company}</span>
                          <span class="text-xs tabular-nums text-ink-300">{g.years}</span>
                        </p>
                        <p class="text-sm text-ink-100">{g.role[lang]}</p>
                        <p class="mt-1.5 text-sm leading-relaxed text-ink-200">{g.note[lang]}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="mt-6">
                <h4 class="sr-only">{copy.stack}</h4>
                <ul class="flex flex-wrap gap-1.5">
                  {role.stack.map((s) => <li class="exp-chip">{s}</li>)}
                </ul>
              </div>

              {!isGroup && (
                <p class="mt-6 border-t border-border pt-4 text-sm leading-relaxed text-ink-200">
                  <span class="font-semibold text-ink-100">{copy.about}: </span>{company.about[lang]}
                </p>
              )}

              {role.links && role.links.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {role.links.map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noopener noreferrer" class="exp-link">
                        {link.label[lang]}
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
                        <span class="sr-only">{lang === 'en' ? '(opens in a new tab)' : '(se abre en otra pestaña)'}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              {testimonial && (
                <figure class:list={['exp-quote', { 'is-draft': testimonial.status === 'draft' }]}>
                  <figcaption class="mb-2 flex flex-wrap items-center gap-2 text-xs font-semibold text-ink-200">
                    {copy.recommended}
                    {testimonial.status === 'draft' && <span class="exp-draft">{copy.draft}</span>}
                  </figcaption>
                  <blockquote class="text-[0.95rem] leading-relaxed text-ink-100">“{testimonial.quote[lang]}”</blockquote>
                  <p class="mt-2 text-sm text-ink-200"><span class="font-semibold text-ink">{testimonial.author}</span>, {testimonial.role[lang]}</p>
                </figure>
              )}
            </article>
          </li>
        );
      })}
    </ol>
    <p class="hidden text-ink-200" data-exp-empty>{copy.empty}</p>
  </section>

  <section class="border-t border-border">
    <div class="container-page py-12 sm:py-16">
      <div class="closing-panel card-glass flex flex-col items-start justify-between gap-6 p-8 sm:flex-row sm:items-center sm:p-10">
        <div>
          <h2 class="text-2xl sm:text-3xl">{copy.ctaTitle}</h2>
          <p class="mt-2 max-w-xl text-ink-200">{copy.ctaBody}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href={getLocalizedPath('profile', lang)} class="btn btn-primary">{copy.ctaCv}</a>
          <a href={getLocalizedPath('contact', lang)} class="btn btn-outline">{copy.ctaContact}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .exp-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .exp-filter {
    border-radius: 999px;
    border: 1px solid var(--color-border);
    padding: 0.45rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-200);
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }
  .exp-filter:hover { color: var(--color-ink); border-color: var(--color-ink-300); }
  .exp-filter[aria-pressed='true'] { color: #fff; background: var(--color-blue); border-color: var(--color-blue); }
  .exp-filter:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 2px; }

  .exp-list { list-style: none; margin: 0; padding: 0; }
  .exp-item {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    column-gap: 0.9rem;
    scroll-margin-top: 6rem;
  }
  .exp-item[hidden] { display: none; }
  .exp-when { display: none; }
  .exp-rail { position: relative; grid-row: 1; grid-column: 1; }
  .exp-rail::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--color-border);
  }
  .exp-dot {
    position: absolute;
    top: 1.6rem;
    left: 50%;
    width: 0.85rem;
    height: 0.85rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: var(--brand);
    box-shadow: 0 0 0 4px var(--color-midnight);
  }
  .exp-dot.is-current { box-shadow: 0 0 0 4px var(--color-midnight), 0 0 0 6px var(--color-success); }
  .exp-card {
    grid-column: 2;
    margin-bottom: 1.5rem;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--brand);
    border-radius: 1rem;
    background: var(--color-carbon);
    padding: 1.25rem;
  }
  .exp-item:target .exp-card { box-shadow: 0 0 0 2px var(--color-blue), var(--shadow-md); }
  @media (min-width: 640px) { .exp-card { padding: 1.75rem 2rem; } }
  @media (min-width: 1024px) {
    .exp-item { grid-template-columns: 10rem 2.5rem minmax(0, 1fr); column-gap: 1.25rem; }
    .exp-when { display: block; grid-column: 1; padding-top: 1.3rem; text-align: right; }
    .exp-rail { grid-column: 2; }
    .exp-card { grid-column: 3; }
    .exp-period-inline { display: none; }
  }
  .exp-period { font-family: var(--font-heading); font-weight: 600; color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .exp-duration { margin-top: 0.15rem; font-size: 0.85rem; color: var(--color-ink-300); }
  .exp-logo {
    display: flex;
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 0.8rem;
    background: #fff;
    padding: 0.45rem;
  }
  .exp-logo img { width: 100%; height: 100%; object-fit: contain; }
  .exp-logo span { font-family: var(--font-heading); font-weight: 700; font-size: 1.1rem; color: var(--brand); }
  .exp-badge {
    margin-left: 0.5rem;
    display: inline-block;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-success) 16%, transparent);
    padding: 0.1rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-success);
    vertical-align: 0.1em;
  }
  .exp-highlights { display: grid; gap: 0.55rem; list-style: none; margin: 0; padding: 0; }
  .exp-highlights li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-ink-200);
  }
  .exp-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 2px;
    background: var(--brand);
  }
  .exp-more { margin-top: 0.55rem; display: flex; flex-direction: column; }
  .exp-more summary {
    order: 2;
    cursor: pointer;
    list-style: none;
    align-self: flex-start;
    margin-top: 0.55rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-blue-soft);
  }
  .exp-more:not([open]) summary { order: 0; margin-top: 0; }
  .exp-more summary::-webkit-details-marker { display: none; }
  .exp-more summary:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 2px; border-radius: 4px; }
  .exp-more .when-open, .exp-more[open] .when-closed { display: none; }
  .exp-more[open] .when-open { display: inline; }
  .exp-chip {
    border-radius: 0.4rem;
    border: 1px solid var(--color-border);
    background: var(--color-glass);
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    color: var(--color-ink-100);
  }
  .exp-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink-100);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .exp-link:hover { color: var(--color-ink); border-color: color-mix(in srgb, var(--brand) 60%, transparent); }
  .exp-quote {
    margin: 1.5rem 0 0;
    border-left: 3px solid var(--brand);
    border-radius: 0 0.75rem 0.75rem 0;
    background: var(--color-glass);
    padding: 1rem 1.25rem;
  }
  .exp-quote.is-draft { border-left-style: dashed; opacity: 0.8; }
  .exp-draft {
    border-radius: 999px;
    border: 1px dashed var(--color-warning);
    padding: 0 0.5rem;
    font-weight: 500;
    color: var(--color-warning);
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('[data-exp-filters]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-exp-list] > li'));
  const empty = document.querySelector<HTMLElement>('[data-exp-empty]');
  group?.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!btn) return;
    const filter = btn.dataset.filter!;
    group.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    let visible = 0;
    items.forEach((item) => {
      const show = filter === 'all' || (item.dataset.tracks || '').split(' ').includes(filter);
      item.hidden = !show;
      if (show) visible++;
    });
    empty?.classList.toggle('hidden', visible > 0);
  });

  // Al llegar con #rol (desde el gráfico o la Home): mostrarlo y abrir sus detalles
  const openFromHash = () => {
    const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (!target || !target.matches('[data-exp-list] > li')) return;
    if (target.hidden) group?.querySelector<HTMLButtonElement>('[data-filter="all"]')?.click();
    target.querySelector('details')?.setAttribute('open', '');
  };
  window.addEventListener('hashchange', openFromHash);
  openFromHash();
</script>
