---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site.ts';
import { companies, roles } from '@data/career.ts';
import type { ServiceDetail } from '@data/services.ts';
import { getLangFromUrl, getLocalizedPath } from '@i18n/ui.ts';
import { serviceJsonLd } from '@lib/seo.ts';

interface Props { service: ServiceDetail }
const { service } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const L = <T,>(v: Record<'es' | 'en', T>) => v[lang];

const copy = lang === 'en'
  ? { home: 'Home', services: 'Services', includes: 'What is included', process: 'How we work', stack: 'Typical stack', idealFor: 'Ideal for', notFor: 'Not a fit for', pricing: 'Investment', faq: 'Frequently asked questions', proof: 'Where I have done this', proofLink: 'See the role', cta: 'Tell me about your project', ctaBody: 'I usually reply within 24 hours.' }
  : { home: 'Inicio', services: 'Servicios', includes: 'Qué incluye', process: 'Cómo trabajamos', stack: 'Stack habitual', idealFor: 'Ideal para', notFor: 'No encaja si', pricing: 'Inversión', faq: 'Preguntas frecuentes', proof: 'Dónde lo he hecho', proofLink: 'Ver el rol', cta: 'Cuéntame tu proyecto', ctaBody: 'Normalmente respondo en menos de 24 horas.' };

const jsonLd = serviceJsonLd({ name: L(service.name), description: L(service.description), provider: site.name });
const iconPaths: Record<string, string> = {
  web: '<path d="M8 9l-3 3 3 3"/><path d="M16 9l3 3-3 3"/><path d="M14 5l-4 14"/>',
  mobile: '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/>',
  stack: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/><path d="M3 18l9 5 9-5"/>',
  wrench: '<path d="M14.7 6.3a4 4 0 00-5.4 5.4l-6 6a2 2 0 102.8 2.8l6-6a4 4 0 005.4-5.4l-2.5 2.5-2.8-2.8z"/>',
  sparkles: '<path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5z"/><path d="M19 14l.8 2.4L22 17l-2.2.6L19 20l-.8-2.4L16 17l2.2-.6z"/>',
};
const experienceUrl = getLocalizedPath('experience', lang);
---

<BaseLayout title={L(service.name)} description={L(service.tagline)}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero-editorial relative overflow-hidden">
    <div class="container-page relative max-w-4xl pt-10 pb-12 sm:pt-14 sm:pb-16">
      <nav class="mb-8 text-sm text-ink-200" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={getLocalizedPath('home', lang)} class="hover:text-ink">{copy.home}</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={getLocalizedPath('services', lang)} class="hover:text-ink">{copy.services}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ink-100" aria-current="page">{L(service.name)}</li>
        </ol>
      </nav>
      <span class="svc-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[service.icon]} />
      </span>
      <h1 class="mt-5 text-balance">{L(service.name)}</h1>
      <p class="mt-4 max-w-2xl text-xl leading-relaxed text-ink-100">{L(service.tagline)}</p>
      <p class="mt-4 max-w-2xl leading-relaxed text-ink-200">{L(service.description)}</p>
      <a href={getLocalizedPath('contact', lang)} class="btn btn-primary mt-8">{copy.cta}</a>
    </div>
  </section>

  <div class="container-page max-w-4xl space-y-14 py-14 sm:py-16">
    <section aria-labelledby="proof-title">
      <h2 id="proof-title" class="svc-h2">{copy.proof}</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {service.proof.map((p) => {
          const role = roles.find((r) => r.id === p.roleId);
          const c = role ? companies[role.companyId] : undefined;
          return role && c ? (
            <li>
              <a href={`${experienceUrl}#${role.id}`} class="svc-proof" style={`--brand:${c.color}`}>
                <span class="svc-proof-logo">{c.mark ? <img src={c.mark} alt="" width="28" height="28" /> : c.name.charAt(0)}</span>
                <span class="min-w-0">
                  <span class="block font-semibold text-ink">{c.name}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-ink-200">{L(p.note)}</span>
                  <span class="mt-2 inline-block text-sm font-semibold text-blue-200">{copy.proofLink}</span>
                </span>
              </a>
            </li>
          ) : null;
        })}
      </ul>
    </section>

    <section aria-labelledby="inc-title">
      <h2 id="inc-title" class="svc-h2">{copy.includes}</h2>
      <ul class="svc-list">
        {L(service.features).map((f) => <li>{f}</li>)}
      </ul>
    </section>

    <section aria-labelledby="proc-title">
      <h2 id="proc-title" class="svc-h2">{copy.process}</h2>
      <ol class="grid gap-3 sm:grid-cols-2">
        {L(service.process).map((step, i) => (
          <li class="svc-step">
            <span class="svc-step-num">{i + 1}</span>
            <div>
              <h3 class="text-base font-semibold text-ink">{step.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-ink-200">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="stack-title">
      <h2 id="stack-title" class="svc-h2">{copy.stack}</h2>
      <ul class="flex flex-wrap gap-2">
        {service.stack.map((tech) => <li class="rounded-full border border-border bg-white/5 px-3 py-1.5 text-sm font-medium text-ink-100">{tech}</li>)}
      </ul>
    </section>

    <section class="grid gap-4 sm:grid-cols-2">
      <div class="svc-box">
        <h2 class="text-sm font-semibold text-green">{copy.idealFor}</h2>
        <p class="mt-2 leading-relaxed text-ink-100">{L(service.idealFor)}</p>
      </div>
      <div class="svc-box">
        <h2 class="text-sm font-semibold text-ink-200">{copy.notFor}</h2>
        <p class="mt-2 leading-relaxed text-ink-100">{L(service.notFor)}</p>
      </div>
    </section>

    <section class="closing-panel card-glass p-6 sm:p-8" aria-labelledby="price-title">
      <h2 id="price-title" class="text-sm font-semibold text-ink-200">{copy.pricing}</h2>
      <p class="mt-2 font-display text-xl font-bold text-ink sm:text-2xl">{L(service.pricing)}</p>
    </section>

    <section aria-labelledby="faq-title">
      <h2 id="faq-title" class="svc-h2">{copy.faq}</h2>
      <div class="space-y-3">
        {L(service.faq).map((q) => (
          <details class="svc-faq group">
            <summary>
              {q.question}
              <svg class="h-5 w-5 shrink-0 text-ink-200 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-3 leading-relaxed text-ink-200">{q.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="border-t border-border pt-10 text-center">
      <a href={getLocalizedPath('contact', lang)} class="btn btn-primary">{copy.cta}</a>
      <p class="mt-3 text-sm text-ink-300">{copy.ctaBody}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .svc-icon { display: inline-flex; width: 3rem; height: 3rem; align-items: center; justify-content: center; border-radius: 0.8rem; border: 1px solid color-mix(in srgb, var(--color-blue) 35%, transparent); background: color-mix(in srgb, var(--color-blue) 12%, transparent); color: var(--color-blue-soft); }
  .svc-h2 { margin-bottom: 1.1rem; font-size: 1.5rem; }
  .svc-list { display: grid; gap: 0.6rem; list-style: none; margin: 0; padding: 0; }
  .svc-list li { position: relative; padding-left: 1.6rem; line-height: 1.6; color: var(--color-ink-100); }
  .svc-list li::before { content: ''; position: absolute; left: 0.1rem; top: 0.42em; width: 0.9rem; height: 0.5rem; border-left: 2px solid var(--color-success); border-bottom: 2px solid var(--color-success); transform: rotate(-45deg); }
  .svc-step, .svc-box, .svc-faq { border: 1px solid var(--color-border); border-radius: 1rem; background: var(--color-carbon); padding: 1.15rem 1.25rem; }
  .svc-step { display: flex; gap: 0.9rem; }
  .svc-step-num { display: inline-flex; width: 1.8rem; height: 1.8rem; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 999px; background: var(--color-blue); font-size: 0.85rem; font-weight: 700; color: #fff; }
  .svc-proof { display: flex; height: 100%; gap: 0.9rem; border: 1px solid var(--color-border); border-left: 3px solid var(--brand); border-radius: 1rem; background: var(--color-carbon); padding: 1rem 1.15rem; transition: border-color 0.15s ease; }
  .svc-proof:hover { border-color: color-mix(in srgb, var(--brand) 55%, var(--color-border)); }
  .svc-proof:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 2px; }
  .svc-proof-logo { display: inline-flex; width: 2.4rem; height: 2.4rem; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 0.6rem; background: #fff; padding: 0.3rem; font-weight: 700; color: var(--brand); }
  .svc-proof-logo img { width: 100%; height: 100%; object-fit: contain; }
  .svc-faq summary { display: flex; cursor: pointer; list-style: none; align-items: center; justify-content: space-between; gap: 1rem; font-weight: 600; color: var(--color-ink); }
  .svc-faq summary::-webkit-details-marker { display: none; }
  .svc-faq summary:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 4px; border-radius: 4px; }
</style>
