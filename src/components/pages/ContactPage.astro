---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site.ts';
import { t } from '@i18n/ui.ts';
---

<BaseLayout title={t(Astro.url, 'contact.eyebrow') + ' · Yahyr Paredes'} description={t(Astro.url, 'contact.body')}>
  <section class="container-page pt-16 sm:pt-20 pb-12">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-5">{t(Astro.url, 'contact.eyebrow')}</p>
        <h1 class="text-balance mb-6">
          {t(Astro.url, 'contact.title_start')}{' '}
          <span class="text-blue-200 font-display italic font-medium">{t(Astro.url, 'contact.title_strong')}</span>
          {t(Astro.url, 'contact.title_end')}
        </h1>
        <p class="text-ink-100 text-lg leading-relaxed mb-10">{t(Astro.url, 'contact.body')}</p>
        <div class="space-y-5">
          <div class="flex items-start gap-3">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-blue-200 flex-shrink-0 mt-0.5" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
            <div>
              <p class="text-xs text-ink-300 uppercase tracking-wider mb-0.5">{t(Astro.url, 'contact.email_label')}</p>
              <a href={`mailto:${site.email}`} class="text-ink hover:text-blue-200 transition-colors">{site.email}</a>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-blue-200 flex-shrink-0 mt-0.5" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <div>
              <p class="text-xs text-ink-300 uppercase tracking-wider mb-0.5">{t(Astro.url, 'contact.location_label')}</p>
              <p class="text-ink">{t(Astro.url, 'contact.location_value')}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-blue-200 flex-shrink-0 mt-0.5" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <div>
              <p class="text-xs text-ink-300 uppercase tracking-wider mb-0.5">{t(Astro.url, 'contact.response_label')}</p>
              <p class="text-ink">{t(Astro.url, 'contact.response_value')}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="card p-6 sm:p-8 lg:p-10">
          <h2 class="text-2xl sm:text-3xl mb-2">{t(Astro.url, 'contact.form_title')}</h2>
          <p class="text-ink-200 mb-6">{t(Astro.url, 'contact.form_subtitle')}</p>

          <form class="space-y-4" onsubmit="event.preventDefault(); alert('Form submitted (demo)');">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs text-ink-300 uppercase tracking-wider mb-1.5">{t(Astro.url, 'contact.form_name')}</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg bg-midnight border border-border text-ink placeholder:text-ink-300 focus:border-blue-200 focus:outline-none transition-colors" placeholder={t(Astro.url, 'contact.form_name')} />
              </div>
              <div>
                <label for="email" class="block text-xs text-ink-300 uppercase tracking-wider mb-1.5">{t(Astro.url, 'contact.form_email')}</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg bg-midnight border border-border text-ink placeholder:text-ink-300 focus:border-blue-200 focus:outline-none transition-colors" placeholder={t(Astro.url, 'contact.form_email')} />
              </div>
            </div>

            <div>
              <label for="company" class="block text-xs text-ink-300 uppercase tracking-wider mb-1.5">{t(Astro.url, 'contact.form_company')}</label>
              <input type="text" id="company" name="company" class="w-full px-4 py-3 rounded-lg bg-midnight border border-border text-ink placeholder:text-ink-300 focus:border-blue-200 focus:outline-none transition-colors" placeholder={t(Astro.url, 'contact.form_company')} />
            </div>

            <div>
              <label for="message" class="block text-xs text-ink-300 uppercase tracking-wider mb-1.5">{t(Astro.url, 'contact.form_message')}</label>
              <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-lg bg-midnight border border-border text-ink placeholder:text-ink-300 focus:border-blue-200 focus:outline-none transition-colors resize-none" placeholder={t(Astro.url, 'contact.form_message')}></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-full sm:w-auto">
              {t(Astro.url, 'contact.form_send')}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>

            <p class="text-xs text-ink-300 flex items-center gap-1.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-ink-300" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              {t(Astro.url, 'contact.form_privacy')}
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-midnight-100/30">
    <div class="container-page py-10">
      <p class="font-display font-semibold text-ink mb-6">{t(Astro.url, 'contact.other_ways')}</p>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <a href={site.socials.find((s) => s.icon === 'linkedin')?.url || 'https://linkedin.com/in/yahyrparedes'} target="_blank" rel="noopener noreferrer" class="card p-4 flex items-center gap-3 group hover:border-blue-200/50">
          <div class="w-9 h-9 rounded-lg bg-blue/10 border border-blue/20 flex items-center justify-center flex-shrink-0 group-hover:bg-blue/20 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-blue-200" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </div>
          <div class="min-w-0">
            <p class="text-xs text-ink-300 uppercase tracking-wider">LinkedIn</p>
            <p class="text-sm text-ink truncate">/yahyr-paredes</p>
          </div>
        </a>
        <a href={site.socials.find((s) => s.icon === 'github')?.url || 'https://github.com/yahyrparedes'} target="_blank" rel="noopener noreferrer" class="card p-4 flex items-center gap-3 group hover:border-blue-200/50">
          <div class="w-9 h-9 rounded-lg bg-blue/10 border border-blue/20 flex items-center justify-center flex-shrink-0 group-hover:bg-blue/20 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-blue-200" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </div>
          <div class="min-w-0">
            <p class="text-xs text-ink-300 uppercase tracking-wider">GitHub</p>
            <p class="text-sm text-ink truncate">/yahyr-paredes</p>
          </div>
        </a>
        <a href="https://twitter.com/yahyr_paredes" target="_blank" rel="noopener noreferrer" class="card p-4 flex items-center gap-3 group hover:border-blue-200/50">
          <div class="w-9 h-9 rounded-lg bg-blue/10 border border-blue/20 flex items-center justify-center flex-shrink-0 group-hover:bg-blue/20 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-blue-200" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </div>
          <div class="min-w-0">
            <p class="text-xs text-ink-300 uppercase tracking-wider">Twitter / X</p>
            <p class="text-sm text-ink truncate">@yahyr_paredes</p>
          </div>
        </a>
        <a href="/cv-yahyr-paredes.pdf" class="card p-4 flex items-center gap-3 group hover:border-blue-200/50">
          <div class="w-9 h-9 rounded-lg bg-blue/10 border border-blue/20 flex items-center justify-center flex-shrink-0 group-hover:bg-blue/20 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-blue-200" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6M9 15l3 3 3-3"/></svg>
          </div>
          <div class="min-w-0">
            <p class="text-xs text-ink-300 uppercase tracking-wider">{t(Astro.url, 'contact.resume')}</p>
            <p class="text-sm text-ink truncate">{t(Astro.url, 'contact.resume_action')}</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
