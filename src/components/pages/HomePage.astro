---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site.ts';
import { t, getLangFromUrl } from '@i18n/ui.ts';

const currentLang = getLangFromUrl(Astro.url);

const selectedWork = currentLang === 'en'
  ? [
      {
        name: 'Starbucks Perú',
        tag: 'STARBUCKS PERÚ',
        tagColor: 'green',
        title: 'Modernizing the Starbucks Rewards experience',
        body: 'New mobile experience built with Kotlin Multiplatform, Compose and SwiftUI.',
        href: '/en/experience',
      },
      {
        name: 'Kwema',
        tag: 'KWEMA',
        tagColor: 'blue',
        title: 'Safety in real-time critical environments',
        body: 'Mobile platform using BLE, iBeacon and background services to protect workers when it matters most.',
        href: '/en/experience',
      },
      {
        name: 'Interseguro',
        tag: 'INTERSEGURO',
        tagColor: 'orange',
        title: 'Scaling an insurance platform to the next level',
        body: 'Migration, new features and performance improvements for one of the most critical insurance products in Peru.',
        href: '/en/experience',
      },
    ]
  : [
      {
        name: 'Starbucks Perú',
        tag: 'STARBUCKS PERÚ',
        tagColor: 'green',
        title: 'Modernizando la experiencia Starbucks Rewards',
        body: 'Nueva experiencia móvil construida con Kotlin Multiplatform, Compose y SwiftUI.',
        href: '/es/experience',
      },
      {
        name: 'Kwema',
        tag: 'KWEMA',
        tagColor: 'blue',
        title: 'Seguridad en entornos críticos en tiempo real',
        body: 'Plataforma móvil que usa BLE, iBeacon y servicios en segundo plano para proteger a los trabajadores cuando más importa.',
        href: '/es/experience',
      },
      {
        name: 'Interseguro',
        tag: 'INTERSEGURO',
        tagColor: 'orange',
        title: 'Llevando una plataforma de seguros al siguiente nivel',
        body: 'Migración, nuevas funcionalidades y mejoras de rendimiento para uno de los productos de seguros más críticos de Perú.',
        href: '/es/experience',
      },
    ];

const howSteps = [
  { num: '01', titleKey: 'how.discover', descKey: 'how.discover_desc', icon: 'discover' },
  { num: '02', titleKey: 'how.design', descKey: 'how.design_desc', icon: 'design' },
  { num: '03', titleKey: 'how.build', descKey: 'how.build_desc', icon: 'build' },
  { num: '04', titleKey: 'how.measure', descKey: 'how.measure_desc', icon: 'measure' },
  { num: '05', titleKey: 'how.improve', descKey: 'how.improve_desc', icon: 'improve' },
];
---

<BaseLayout
  title={t(Astro.url, 'hero.eyebrow') + ' · ' + site.name}
  description={t(Astro.url, 'hero.subheadline')}
  type="profile"
>
  <section class="bg-hero min-h-[calc(100vh-4rem)] flex items-center relative pt-12 sm:pt-20 pb-16 sm:pb-20">
    <div class="container-page w-full">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-6">{t(Astro.url, 'hero.eyebrow')}</p>

          <h1 class="text-ink mb-6 text-balance font-display font-bold text-4xl sm:text-5xl lg:text-6xl leading-[1.05] tracking-tight">
            {t(Astro.url, 'hero.headline_start')}{' '}
            <span class="relative inline-block text-blue-200">
              {t(Astro.url, 'hero.headline_trust')}
              <svg class="absolute pointer-events-none -z-10" style="left: -8%; right: -8%; top: 50%; bottom: -15%; width: 116%; height: 70%;" viewBox="0 0 280 80" fill="none" preserveAspectRatio="none" aria-hidden="true">
                <path d="M 14 40 C 10 16, 60 4, 140 8 C 220 12, 270 24, 266 40 C 262 56, 200 64, 130 62 C 70 60, 26 56, 14 40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none" />
              </svg>
            </span>
            {t(Astro.url, 'hero.headline_end')}
          </h1>

          <p class="text-ink-100 text-lg sm:text-xl max-w-2xl leading-relaxed mb-8">
            {t(Astro.url, 'hero.subheadline')}
          </p>

          <div class="flex flex-wrap gap-3 mb-10">
            <a href={currentLang === 'en' ? '/en/contact' : '/es/contacto'} class="btn btn-primary">
              {t(Astro.url, 'hero.cta_primary')}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href={currentLang === 'en' ? '/en/experience' : '/es/experience'} class="btn btn-outline">
              {t(Astro.url, 'hero.cta_secondary')}
            </a>
          </div>

          <div class="flex flex-wrap gap-x-6 gap-y-3">
            {['hero.pill_mobile', 'hero.pill_backend', 'hero.pill_cloud', 'hero.pill_ai', 'hero.pill_architecture', 'hero.pill_product'].map((key) => (
              <span class="inline-flex items-center gap-2 text-sm text-ink-200">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-blue-200" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                </svg>
                {t(Astro.url, key)}
              </span>
            ))}
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative aspect-[3/2] w-full max-w-md mx-auto lg:mx-0 lg:max-w-none">
            <img
              src="/images/hero-banner.png"
              alt={site.name}
              class="relative w-full h-full object-cover rounded-2xl ring-1 ring-border"
              width="1536"
              height="1024"
              loading="eager"
            />
          </div>

          <div class="hidden lg:block absolute bottom-6 right-4 w-60 card p-4 bg-midnight-100/95 backdrop-blur-sm">
            <div class="flex items-center justify-between mb-2.5">
              <p class="text-[11px] text-ink-300 uppercase tracking-wider font-semibold">{t(Astro.url, 'hero.currently_label')}</p>
              <span class="w-1.5 h-1.5 rounded-full bg-green animate-pulse" aria-hidden="true"></span>
            </div>
            <p class="text-sm text-ink leading-snug mb-3.5">{t(Astro.url, 'hero.currently_title')}</p>
            <p class="text-xs text-blue-200 font-semibold">{t(Astro.url, 'hero.currently_footer')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-midnight-100/30 mt-8">
    <div class="container-page py-10">
      <p class="eyebrow text-center mb-6">{t(Astro.url, 'trust.label')}</p>
      <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
        {['Starbucks', 'Kwema', 'Interseguro', 'Urbaner', 'Atlas', 'DELOSI'].map((logo) => (
          <span class="text-ink-200 font-display font-bold text-base sm:text-lg tracking-tight opacity-70 hover:opacity-100 transition-opacity">
            {logo}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-12 sm:py-16">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center lg:text-left">
        <p class="font-display font-bold text-4xl sm:text-5xl text-ink tracking-tight">{t(Astro.url, 'stats.years_value')}</p>
        <p class="mt-2 text-sm text-ink-200">{t(Astro.url, 'stats.years_label')}</p>
      </div>
      <div class="text-center lg:text-left">
        <p class="font-display font-bold text-4xl sm:text-5xl text-ink tracking-tight">{t(Astro.url, 'stats.products_value')}</p>
        <p class="mt-2 text-sm text-ink-200">{t(Astro.url, 'stats.products_label')}</p>
      </div>
      <div class="text-center lg:text-left">
        <p class="font-display font-bold text-4xl sm:text-5xl text-ink tracking-tight">{t(Astro.url, 'stats.industries_value')}</p>
        <p class="mt-2 text-sm text-ink-200">{t(Astro.url, 'stats.industries_label')}</p>
      </div>
      <div class="text-center lg:text-left">
        <p class="font-display font-bold text-3xl sm:text-4xl text-ink tracking-tight">{t(Astro.url, 'stats.worldwide_label')}</p>
        <p class="mt-2 text-sm text-ink-200">{t(Astro.url, 'stats.worldwide_sub')}</p>
      </div>
    </div>
  </section>

  <section class="container-page py-12 sm:py-16 border-t border-border">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="eyebrow mb-2">{t(Astro.url, 'work.eyebrow')}</p>
        <h2 class="text-balance">{t(Astro.url, 'work.title')}</h2>
      </div>
      <a href={currentLang === 'en' ? '/en/experience' : '/es/experience'} class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-blue-200 hover:text-blue transition-colors">
        {t(Astro.url, 'work.view_all')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {selectedWork.map((work) => (
        <a href={work.href} class="card overflow-hidden group flex flex-col hover:border-blue-200/50 transition-colors">
          <div class={`relative aspect-[4/3] overflow-hidden bg-gradient-to-br ${work.tagColor === 'green' ? 'from-green/20 via-midnight-200 to-midnight-100' : work.tagColor === 'blue' ? 'from-blue-200/20 via-midnight-200 to-midnight-100' : 'from-orange/20 via-midnight-200 to-midnight-100'}`}>
            <div class="absolute inset-0 flex items-center justify-center">
              <span class="text-3xl font-display font-bold text-ink-200/40 uppercase tracking-wider">{work.name}</span>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <p class={`text-xs font-semibold uppercase tracking-wider mb-3 ${work.tagColor === 'green' ? 'text-green' : work.tagColor === 'blue' ? 'text-blue-200' : 'text-orange'}`}>{work.tag}</p>
            <h3 class="font-display font-bold text-lg text-ink mb-2 leading-snug">{work.title}</h3>
            <p class="text-sm text-ink-200 leading-relaxed mb-4 flex-1">{work.body}</p>
            <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-200 group-hover:translate-x-1 transition-transform">
              {currentLang === 'en' ? 'View case study' : 'Ver caso de estudio'}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container-page py-16 sm:py-24">
    <p class="eyebrow mb-2">{t(Astro.url, 'how.eyebrow')}</p>
    <h2 class="text-balance max-w-2xl mb-16">{t(Astro.url, 'how.title')}</h2>
    <div class="relative">
      <div class="hidden lg:block absolute top-6 left-[8%] right-[8%] h-px border-t border-dashed border-blue/40"></div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-y-10 gap-x-6">
        {howSteps.map((step) => (
          <div class="text-center relative">
            <div class="inline-flex w-12 h-12 rounded-full bg-midnight-100 border border-blue/30 items-center justify-center mb-4 relative z-10">
              <span class="text-blue-200 font-bold text-sm">{step.num}</span>
            </div>
            <p class="font-display font-bold text-base text-ink mb-2">{t(Astro.url, step.titleKey)}</p>
            <p class="text-sm text-ink-200 leading-relaxed">{t(Astro.url, step.descKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="container-page py-16 sm:py-24">
      <div class="card p-8 sm:p-12 max-w-5xl mx-auto relative overflow-hidden bg-gradient-to-br from-midnight-100 via-midnight-100 to-blue/5">
        <div class="grid sm:grid-cols-2 gap-8 items-center relative">
          <div>
            <h2 class="text-balance mb-4">
              {t(Astro.url, 'cta.title')}{' '}
              <span class="text-blue-200">{t(Astro.url, 'cta.title_strong')}</span>.
            </h2>
            <p class="text-ink-200 leading-relaxed">{t(Astro.url, 'cta.body')}</p>
          </div>

          <div class="space-y-3">
            <a href={`mailto:${site.email}`} class="flex items-center gap-3 text-sm text-ink-200 hover:text-ink transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-blue-200" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              {site.email}
            </a>
            <a href={site.socials.find((s) => s.icon === 'linkedin')?.url || 'https://linkedin.com/in/yahyrparedes'} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm text-ink-200 hover:text-ink transition-colors">
              LinkedIn
            </a>
            <a href={site.socials.find((s) => s.icon === 'github')?.url || 'https://github.com/yahyrparedes'} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm text-ink-200 hover:text-ink transition-colors">
              GitHub
            </a>
            <a href={currentLang === 'en' ? '/en/contact' : '/es/contacto'} class="btn btn-primary mt-5">
              {t(Astro.url, 'cta.cta_primary')}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
