---
import BaseLayout from '@layouts/BaseLayout.astro';
import CareerGraph from '@components/CareerGraph.astro';
import { site } from '@data/site.ts';
import { t, getLangFromUrl, getLocalizedPath } from '@i18n/ui.ts';
import { featuredRoles, companies, trustedBy, formatPeriod, yearsOfExperience } from '@data/career.ts';

const lang = getLangFromUrl(Astro.url);
const years = yearsOfExperience();
const experienceUrl = getLocalizedPath('experience', lang);

const copy = lang === 'en'
  ? {
      title: 'Yahyr Paredes · Android & backend engineer',
      description: `Android & backend engineer (Kotlin, Go, Java, Python), open to new opportunities. ${years} years shipping apps and services to production; until August 2026, Android at Starbucks Peru. Based in Spain.`,
      headline: 'Building products people trust.',
      sub: `Android and backend engineer with Kotlin, Go, Java and Python. ${years} years taking apps and services to production; until August 2026 I owned the Starbucks Peru Android app. Based in Jaén, Spain.`,
      status: 'Open to work · Android & backend',
      ctaPrimary: 'See my experience',
      ctaSecondary: "Let's talk",
      nowLabel: 'Available now',
      nowTitle: 'Looking for my next role',
      now: [
        'Android (Kotlin, Compose, KMP) or backend (Go, Java, Python)',
        'Remote, hybrid or on-site in Spain',
        'Authorized to work in Spain',
        'Last role: Android Engineer at Starbucks Peru (Sep 2024 – Aug 2026)',
      ],
      nowLink: 'Contact me',
      nowLink2: 'See my CV',
      trust: 'Companies I have worked with',
      workTitle: 'Selected work',
      workIntro: 'Products in production for food & beverage, insurance, workplace safety, logistics and retail.',
      details: 'Read the case',
      earlyTitle: 'Before that: 2016 – 2019',
      earlyBody: 'Android and mobile at ESAN, Force Close, Avances Tecnológicos, Intercorp and more.',
      graphTitle: 'My career at a glance',
      graphLink: 'Full timeline',
      ctaTitle: 'Have a product that needs to work in production?',
      ctaBody: 'I can join your team, take over an Android app or untangle a backend. Tell me what you are building.',
      ctaButton: 'Write to me',
    }
  : {
      title: 'Yahyr Paredes · Ingeniero Android y backend',
      description: `Ingeniero Android y backend (Kotlin, Go, Java, Python), disponible para nuevas oportunidades. ${years} años llevando apps y servicios a producción; hasta agosto de 2026, Android en Starbucks Perú. Desde España.`,
      headline: 'Construyendo productos en los que la gente confía.',
      sub: `Ingeniero Android y backend con Kotlin, Go, Java y Python. ${years} años llevando apps y servicios a producción; hasta agosto de 2026 fui responsable de la app Android de Starbucks Perú. Desde Jaén, España.`,
      status: 'Disponible para trabajar · Android y backend',
      ctaPrimary: 'Ver mi experiencia',
      ctaSecondary: 'Hablemos',
      nowLabel: 'Disponible · incorporación inmediata',
      nowTitle: 'Busco mi próximo reto',
      now: [
        'Android (Kotlin, Compose, KMP) o backend (Go, Java, Python)',
        'En remoto, híbrido o presencial en España',
        'Autorización para trabajar en España',
        'Último rol: Android Engineer en Starbucks Perú (sep 2024 – ago 2026)',
      ],
      nowLink: 'Escríbeme',
      nowLink2: 'Ver mi CV',
      trust: 'Empresas con las que he trabajado',
      workTitle: 'Trabajo seleccionado',
      workIntro: 'Productos en producción para restauración, seguros, seguridad laboral, logística y retail.',
      details: 'Ver el caso',
      earlyTitle: 'Antes: 2016 – 2019',
      earlyBody: 'Android y mobile en ESAN, Force Close, Avances Tecnológicos, Intercorp y más.',
      graphTitle: 'Mi carrera de un vistazo',
      graphLink: 'Línea de tiempo completa',
      ctaTitle: '¿Tienes un producto que tiene que funcionar en producción?',
      ctaBody: 'Puedo sumarme a tu equipo, hacerme cargo de una app Android o desenredar un backend. Cuéntame qué estás construyendo.',
      ctaButton: 'Escríbeme',
    };

const howSteps = [
  { num: '01', titleKey: 'how.discover', descKey: 'how.discover_desc' },
  { num: '02', titleKey: 'how.design', descKey: 'how.design_desc' },
  { num: '03', titleKey: 'how.build', descKey: 'how.build_desc' },
  { num: '04', titleKey: 'how.measure', descKey: 'how.measure_desc' },
  { num: '05', titleKey: 'how.improve', descKey: 'how.improve_desc' },
];
---

<BaseLayout title={copy.title} description={copy.description} type="profile">
  <!-- HERO -->
  <section class="hero-editorial relative overflow-hidden">
    <div class="absolute inset-0 lg:left-[43%]" aria-hidden="true">
      <img src="/images/hero-banner.png" alt="" class="h-full w-full object-cover object-[70%_center] opacity-40 lg:opacity-100" width="1536" height="1024" loading="eager" fetchpriority="high" />
    </div>
    <div class="hero-shade absolute inset-0" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-midnight to-transparent" aria-hidden="true"></div>

    <div class="container-page relative flex min-h-[640px] items-center pt-20 pb-14 sm:pt-24 lg:min-h-[680px]">
      <div class="grid w-full items-end gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7 xl:col-span-6">
          <p class="hero-status mb-5"><span class="hero-status-dot" aria-hidden="true"></span>{copy.status}</p>
          <h1 class="mb-6 text-balance font-display text-[2.6rem] font-bold leading-[1.02] tracking-tight text-ink sm:text-6xl lg:text-7xl">
            {copy.headline}
          </h1>
          <p class="mb-8 max-w-xl text-lg leading-relaxed text-ink-100 sm:text-xl">{copy.sub}</p>
          <div class="flex flex-wrap gap-3">
            <a href={experienceUrl} class="btn btn-primary">{copy.ctaPrimary}</a>
            <a href={getLocalizedPath('contact', lang)} class="btn btn-outline">{copy.ctaSecondary}</a>
          </div>
        </div>

        <aside class="lg:col-span-5 xl:col-span-4 xl:col-start-9" aria-label={copy.nowLabel}>
          <div class="now-card card-glass shadow-soft-lg">
            <div class="flex items-center gap-3">
              <span class="now-logo now-logo-status" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2"/></svg></span>
              <div>
                <p class="flex items-center gap-2 text-xs font-semibold text-ink-200">
                  {copy.nowLabel}
                </p>
                <p class="font-display text-base font-bold text-ink">{copy.nowTitle}</p>
              </div>
            </div>
            <ul class="mt-4 space-y-2.5 border-t border-border pt-4">
              {copy.now.map((item) => (
                <li class="flex gap-2.5 text-sm text-ink-100">
                  <svg class="mt-0.5 shrink-0 text-green" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-5 flex flex-wrap gap-2">
              <a href={getLocalizedPath('contact', lang)} class="btn btn-primary">{copy.nowLink}</a>
              <a href={getLocalizedPath('profile', lang)} class="btn btn-outline">{copy.nowLink2}</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- LOGOS -->
  <section class="border-y border-border bg-carbon/40" aria-labelledby="trust-title">
    <div class="container-page py-10 sm:py-12">
      <h2 id="trust-title" class="mb-6 text-center text-sm font-semibold text-ink-200">{copy.trust}</h2>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {trustedBy.map((c) => (
          <li>
            <a href={`${experienceUrl}#${c.id}`} class="logo-chip" aria-label={c.name}>
              {c.id === 'starbucks' && (<><img src={c.mark} alt="" class="h-9 w-9" /><span class="logo-chip-text" style="color:#00704A">Starbucks<small>Perú</small></span></>)}
              {c.id === 'kwema' && <img src={c.wordmark} alt="" class="h-10 w-auto max-w-[85%]" />}
              {c.id === 'interseguro' && <img src={c.wordmark} alt="" class="h-7 w-auto max-w-[85%]" />}
              {c.id === 'urbaner' && <img src={c.wordmark} alt="" class="h-7 w-auto max-w-[85%]" />}
              {c.id === 'atlas' && (<><img src={c.mark} alt="" class="h-11 w-auto" /><span class="logo-chip-text" style="color:#383638">Calzado<small>Atlas</small></span></>)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>


  <!-- TRABAJO SELECCIONADO -->
  <section class="container-page py-8 sm:py-12" aria-labelledby="work-title">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="work-title" class="text-balance">{copy.workTitle}</h2>
        <p class="mt-2 max-w-xl text-ink-200">{copy.workIntro}</p>
      </div>
    </div>

    <ul class="grid gap-4 sm:gap-5 md:grid-cols-2 lg:grid-cols-3">
      {featuredRoles.map((role) => {
        const c = companies[role.companyId];
        return (
          <li class="work-tile" style={`--brand:${c.color}`}>
            <a href={`${experienceUrl}#${role.id}`} class="work-tile-link">
              <div class="flex items-center gap-3">
                <span class="work-tile-logo"><img src={c.mark} alt="" width="32" height="32" loading="lazy" /></span>
                <div class="min-w-0">
                  <p class="font-display font-bold text-ink">{c.name}</p>
                  <p class="text-xs text-ink-200">{c.industry[lang]}</p>
                </div>
              </div>
              <p class="mt-5 font-display text-lg font-bold leading-snug text-ink">{role.title[lang]}</p>
              <p class="mt-1 text-sm text-ink-300">{formatPeriod(role, lang)}</p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-200">{role.highlights[lang][0]}</p>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {role.stack.slice(0, 4).map((s) => <li class="rounded-md border border-border bg-white/5 px-2 py-0.5 text-[11px] text-ink-100">{s}</li>)}
              </ul>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-200">
                {copy.details}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          </li>
        );
      })}
      <li class="work-tile work-tile-muted" style="--brand:#3B82F6">
        <a href={`${experienceUrl}#previous`} class="work-tile-link">
          <span class="work-tile-logo font-display font-bold text-blue">&lt;/&gt;</span>
          <p class="mt-5 font-display text-lg font-bold leading-snug text-ink">{copy.earlyTitle}</p>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-200">{copy.earlyBody}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-blue-200">
            {copy.details}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </li>
    </ul>
  </section>

  <!-- CARRERA -->
  <section class="container-page py-12 sm:py-16" aria-labelledby="graph-title">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <h2 id="graph-title" class="text-balance">{copy.graphTitle}</h2>
      <a href={experienceUrl} class="text-sm font-semibold text-blue-200 hover:text-ink">{copy.graphLink}</a>
    </div>
    <CareerGraph lang={lang} compact />
  </section>

  <!-- CÓMO TRABAJO -->
  <section class="container-page py-14 sm:py-20" aria-labelledby="how-title">
    <h2 id="how-title" class="mb-12 max-w-2xl text-balance">{t(Astro.url, 'how.title')}</h2>
    <ol class="relative grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
      <div class="absolute left-[8%] right-[8%] top-6 hidden border-t border-dashed border-blue/40 lg:block" aria-hidden="true"></div>
      {howSteps.map((step) => (
        <li class="relative flex gap-4 lg:block lg:text-center">
          <span class="relative z-10 inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-blue/30 bg-midnight-100 text-sm font-bold text-blue-200 lg:mb-4">{step.num}</span>
          <div>
            <p class="mb-1.5 font-display text-base font-bold text-ink">{t(Astro.url, step.titleKey)}</p>
            <p class="text-sm leading-relaxed text-ink-200">{t(Astro.url, step.descKey)}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- CTA -->
  <section class="border-t border-border">
    <div class="container-page py-16 sm:py-20">
      <div class="closing-panel card-glass relative overflow-hidden p-8 sm:p-12">
        <div class="grid items-center gap-8 md:grid-cols-[1.4fr_1fr]">
          <div>
            <h2 class="mb-4 text-balance">{copy.ctaTitle}</h2>
            <p class="leading-relaxed text-ink-200">{copy.ctaBody}</p>
          </div>
          <div class="flex flex-col items-start gap-3">
            <a href={getLocalizedPath('contact', lang)} class="btn btn-primary">{copy.ctaButton}</a>
            <a href={`mailto:${site.email}`} class="text-sm text-ink-200 hover:text-ink">{site.email}</a>
            <div class="flex gap-4 text-sm">
              <a href={site.socials.find((s) => s.icon === 'linkedin')?.url} target="_blank" rel="noopener noreferrer" class="text-ink-200 hover:text-ink">LinkedIn</a>
              <a href={site.socials.find((s) => s.icon === 'github')?.url} target="_blank" rel="noopener noreferrer" class="text-ink-200 hover:text-ink">GitHub</a>
              <a href={getLocalizedPath('profile', lang)} class="text-ink-200 hover:text-ink">CV</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-shade {
    background:
      radial-gradient(circle at 75% 22%, rgba(59, 130, 246, 0.2), transparent 34%),
      linear-gradient(90deg, var(--color-midnight) 0%, color-mix(in srgb, var(--color-midnight) 94%, transparent) 36%, color-mix(in srgb, var(--color-midnight) 62%, transparent) 60%, color-mix(in srgb, var(--color-midnight) 25%, transparent) 100%);
  }
  @media (max-width: 1023px) {
    .hero-shade { background: linear-gradient(180deg, color-mix(in srgb, var(--color-midnight) 70%, transparent), var(--color-midnight) 85%); }
  }
  .now-card { padding: 1.25rem 1.35rem; background: color-mix(in srgb, var(--color-carbon) 90%, transparent); backdrop-filter: blur(14px); }
  .now-logo, .work-tile-logo {
    display: inline-flex;
    width: 2.6rem;
    height: 2.6rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.7rem;
    background: #fff;
    padding: 0.35rem;
  }
  .now-logo-status { background: color-mix(in srgb, var(--color-success) 14%, transparent); color: var(--color-success); }
  .hero-status { display: inline-flex; align-items: center; gap: 0.55rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--color-success) 40%, transparent); background: color-mix(in srgb, var(--color-success) 10%, transparent); padding: 0.35rem 0.9rem; font-size: 0.875rem; font-weight: 600; color: var(--color-success); }
  .hero-status-dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: currentColor; box-shadow: 0 0 0 0 currentColor; animation: status-pulse 2s ease-out infinite; }
  @keyframes status-pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-success) 60%, transparent); } 100% { box-shadow: 0 0 0 8px transparent; } }
  @media (prefers-reduced-motion: reduce) { .hero-status-dot { animation: none; } }
  .now-logo img, .work-tile-logo img { width: 100%; height: 100%; object-fit: contain; }

  .logo-chip {
    display: flex;
    height: 4.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-radius: 0.9rem;
    border: 1px solid var(--color-border);
    background: #fff;
    padding: 0 0.75rem;
    transition: transform 0.15s var(--ease-ui-out), box-shadow 0.15s ease;
  }
  .logo-chip:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .logo-chip:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 3px; }
  .logo-chip-text { display: flex; flex-direction: column; font-family: var(--font-heading); font-weight: 700; font-size: 1rem; line-height: 1.05; }
  .logo-chip-text small { font-size: 0.72rem; font-weight: 600; opacity: 0.75; }

  .work-tile { display: flex; }
  .work-tile-link {
    display: flex;
    width: 100%;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--brand);
    border-radius: 1rem;
    background: var(--color-carbon);
    padding: 1.5rem;
    transition: border-color 0.15s ease, transform 0.15s var(--ease-ui-out);
  }
  .work-tile-link:hover { border-color: color-mix(in srgb, var(--brand) 55%, var(--color-border)); transform: translateY(-2px); }
  .work-tile-link:focus-visible { outline: 2px solid var(--color-blue); outline-offset: 3px; }
  .work-tile-muted .work-tile-link { background: transparent; border-style: dashed; border-top-style: solid; }
  @media (prefers-reduced-motion: reduce) {
    .logo-chip, .work-tile-link { transition: none; }
    .logo-chip:hover, .work-tile-link:hover { transform: none; }
  }
</style>
