---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site.ts';
import { t, getLangFromUrl } from '@i18n/ui.ts';

const currentLang = getLangFromUrl(Astro.url);

const selectedWork = currentLang === 'en'
  ? [
      {
        name: 'Starbucks Perú',
        logo: '/images/logos/starbucks.png',
        tag: 'MOBILE COMMERCE · DEL OSI',
        accent: 'green',
        title: 'Starbucks Perú Android app',
        body: 'Android ownership for the Starbucks Perú customer app: rewards, commerce flows and production mobile evolution.',
        role: 'Android · Mobile architecture',
        meta: ['Kotlin', 'Android', 'Rewards', 'Production app'],
        links: [
          { label: 'Website', href: 'https://www.starbucks.pe/' },
          { label: 'Google Play', href: 'https://play.google.com/store/apps/details?id=com.starbucks.peru&hl=es_419' },
          { label: 'App Store', href: 'https://apps.apple.com/pe/app/starbucks-per%C3%BA/id1409811746' },
        ],
      },
      {
        name: 'Kwema',
        logo: '/images/logos/kwema.png',
        tag: 'SAFETY TECH · IOT',
        accent: 'blue',
        title: 'Wearable safety mobile platform',
        body: 'Mobile and IoT work for emergency-response experiences connected to wearable devices and real-world safety protocols.',
        role: 'Mobile · BLE · background services',
        meta: ['BLE', 'iBeacon', 'Geofencing', 'Realtime alerts'],
        links: [
          { label: 'Website', href: 'https://www.kwema.co/' },
          { label: 'Google Play', href: 'https://play.google.com/store/apps/details?id=inc.kwema.kwema2&hl=es_419' },
          { label: 'App Store', href: 'https://apps.apple.com/es/app/kwema/id1144512993' },
        ],
      },
      {
        name: 'Interseguro',
        logo: '/images/logos/interseguro.png',
        tag: 'INSURANCE · FINTECH',
        accent: 'orange',
        title: 'Insurance products and digital flows',
        body: 'Backend and platform evolution for insurance experiences such as vehicle insurance, SOAT and customer-facing digital services.',
        role: 'Backend · architecture · performance',
        meta: ['Java', 'Spring', 'Cloud', 'SOAT / Vehicular'],
        links: [
          { label: 'Website', href: 'https://www.interseguro.pe/' },
          { label: 'Vehicular', href: 'https://www.interseguro.pe/vehicular/' },
          { label: 'SOAT', href: 'https://www.interseguro.pe/soat-digital/' },
        ],
      },
      {
        name: 'Urbaner',
        logo: '/images/logos/urbaner.png',
        tag: 'LOGISTICS · LAST MILE',
        accent: 'cyan',
        title: 'Urban delivery customer app',
        body: 'Mobile experience for on-demand logistics, focused on customer flows, tracking and reliable delivery operations.',
        role: 'Android · mobile product',
        meta: ['Android', 'Maps', 'Tracking', 'Logistics'],
        links: [
          { label: 'Website', href: 'https://www.urbaner.com/' },
          { label: 'Google Play', href: 'https://play.google.com/store/apps/details?id=com.urbaner.client.app&hl=es_419' },
        ],
      },
      {
        name: 'Zapatillas Tigre / Atlas',
        logo: '/images/logos/zapatillas-tigre.png',
        tag: 'RETAIL · E-COMMERCE',
        accent: 'red',
        title: 'Retail technology for Zapatillas Tigre',
        body: 'Technology work for the Atlas retail ecosystem, now connected to the remaining Zapatillas Tigre brand presence.',
        role: 'Web · commerce · operations',
        meta: ['Retail', 'E-commerce', 'Perú', 'Brand systems'],
        links: [
          { label: 'Tigre', href: 'https://zapatillastigre.com/' },
          { label: 'Atlas record', href: 'https://m.universidadperu.com/empresas/marca/20185788599-atlas' },
        ],
      },
    ]
  : [
      {
        name: 'Starbucks Perú',
        logo: '/images/logos/starbucks.png',
        tag: 'MOBILE COMMERCE · DELOSI',
        accent: 'green',
        title: 'App Android de Starbucks Perú',
        body: 'Responsable Android de la app de clientes de Starbucks Perú: rewards, flujos comerciales y evolución móvil en producción.',
        role: 'Android · arquitectura mobile',
        meta: ['Kotlin', 'Android', 'Rewards', 'App en producción'],
        links: [
          { label: 'Web', href: 'https://www.starbucks.pe/' },
          { label: 'Google Play', href: 'https://play.google.com/store/apps/details?id=com.starbucks.peru&hl=es_419' },
          { label: 'App Store', href: 'https://apps.apple.com/pe/app/starbucks-per%C3%BA/id1409811746' },
        ],
      },
      {
        name: 'Kwema',
        logo: '/images/logos/kwema.png',
        tag: 'SAFETY TECH · IOT',
        accent: 'blue',
        title: 'Plataforma móvil para seguridad wearable',
        body: 'Trabajo mobile e IoT para experiencias de respuesta ante emergencias conectadas a wearables y protocolos de seguridad reales.',
        role: 'Mobile · BLE · servicios en background',
        meta: ['BLE', 'iBeacon', 'Geofencing', 'Alertas realtime'],
        links: [
          { label: 'Web', href: 'https://www.kwema.co/' },
          { label: 'Google Play', href: 'https://play.google.com/store/apps/details?id=inc.kwema.kwema2&hl=es_419' },
          { label: 'App Store', href: 'https://apps.apple.com/es/app/kwema/id1144512993' },
        ],
      },
      {
        name: 'Interseguro',
        logo: '/images/logos/interseguro.png',
        tag: 'SEGUROS · FINTECH',
        accent: 'orange',
        title: 'Productos digitales de seguros',
        body: 'Evolución backend y plataforma para experiencias de seguros como vehicular, SOAT y servicios digitales para clientes.',
        role: 'Backend · arquitectura · performance',
        meta: ['Java', 'Spring', 'Cloud', 'SOAT / Vehicular'],
        links: [
          { label: 'Web', href: 'https://www.interseguro.pe/' },
          { label: 'Vehicular', href: 'https://www.interseguro.pe/vehicular/' },
          { label: 'SOAT', href: 'https://www.interseguro.pe/soat-digital/' },
        ],
      },
      {
        name: 'Urbaner',
        logo: '/images/logos/urbaner.png',
        tag: 'LOGÍSTICA · LAST MILE',
        accent: 'cyan',
        title: 'App cliente para delivery urbano',
        body: 'Experiencia mobile para logística bajo demanda, enfocada en flujos de cliente, tracking y operación confiable de entregas.',
        role: 'Android · producto mobile',
        meta: ['Android', 'Mapas', 'Tracking', 'Logística'],
        links: [
          { label: 'Web', href: 'https://www.urbaner.com/' },
          { label: 'Google Play', href: 'https://play.google.com/store/apps/details?id=com.urbaner.client.app&hl=es_419' },
        ],
      },
      {
        name: 'Zapatillas Tigre / Atlas',
        logo: '/images/logos/zapatillas-tigre.png',
        tag: 'RETAIL · E-COMMERCE',
        accent: 'red',
        title: 'Tecnología retail para Zapatillas Tigre',
        body: 'Trabajo tecnológico para el ecosistema retail de Atlas, hoy conectado a la presencia vigente de la marca Zapatillas Tigre.',
        role: 'Web · comercio · operación',
        meta: ['Retail', 'E-commerce', 'Perú', 'Sistemas de marca'],
        links: [
          { label: 'Tigre', href: 'https://zapatillastigre.com/' },
          { label: 'Registro Atlas', href: 'https://m.universidadperu.com/empresas/marca/20185788599-atlas' },
        ],
      },
    ];

const philosophy = currentLang === 'en'
  ? [
      {
        title: 'Think',
        body: 'Understand the product, users and constraints before writing a single line of code.',
      },
      {
        title: 'Build',
        body: 'Engineering focused on maintainability, velocity and production quality.',
      },
      {
        title: 'Scale',
        body: 'Architecture designed to grow without forcing the team to rebuild six months later.',
      },
    ]
  : [
      {
        title: 'Think',
        body: 'Entender el producto, los usuarios y las restricciones antes de escribir una sola línea de código.',
      },
      {
        title: 'Build',
        body: 'Ingeniería enfocada en mantenibilidad, velocidad y calidad de producción.',
      },
      {
        title: 'Scale',
        body: 'Arquitectura diseñada para crecer sin obligar al equipo a rehacerlo seis meses después.',
      },
    ];

const stats = [
  {
    value: currentLang === 'en' ? '+9' : '+9',
    label: currentLang === 'en' ? 'Years building products' : 'Años construyendo productos',
    icon: 'calendar',
  },
  {
    value: '20+',
    label: currentLang === 'en' ? 'Products delivered' : 'Productos entregados',
    icon: 'cube',
  },
  {
    value: '5',
    label: currentLang === 'en' ? 'Industries served' : 'Industrias atendidas',
    icon: 'users',
  },
  {
    value: currentLang === 'en' ? 'Worldwide' : 'Global',
    label: currentLang === 'en' ? 'Remote collaboration' : 'Colaboración remota',
    icon: 'globe',
  },
];

const howSteps = [
  { num: '01', titleKey: 'how.discover', descKey: 'how.discover_desc', icon: 'discover' },
  { num: '02', titleKey: 'how.design', descKey: 'how.design_desc', icon: 'design' },
  { num: '03', titleKey: 'how.build', descKey: 'how.build_desc', icon: 'build' },
  { num: '04', titleKey: 'how.measure', descKey: 'how.measure_desc', icon: 'measure' },
  { num: '05', titleKey: 'how.improve', descKey: 'how.improve_desc', icon: 'improve' },
];
---

<BaseLayout
  title={t(Astro.url, 'hero.eyebrow') + ' · ' + site.name}
  description={t(Astro.url, 'hero.subheadline')}
  type="profile"
>
  <section class="hero-editorial relative overflow-hidden">
    <div class="absolute inset-0 lg:left-[43%]" aria-hidden="true">
      <img
        src="/images/hero-banner.png"
        alt=""
        class="h-full w-full object-cover object-center opacity-50 lg:opacity-100"
        width="1536"
        height="1024"
        loading="eager"
      />
    </div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_75%_22%,rgba(59,130,246,.22),transparent_34%),linear-gradient(90deg,var(--color-midnight)_0%,rgba(11,18,32,.96)_34%,rgba(11,18,32,.68)_58%,rgba(11,18,32,.36)_100%)]" aria-hidden="true"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-midnight to-transparent" aria-hidden="true"></div>

    <div class="container-page relative min-h-[780px] pt-20 sm:pt-28 lg:pt-32 pb-12 sm:pb-16 flex items-center">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-end w-full">
        <div class="lg:col-span-7 xl:col-span-6">
          <p class="eyebrow mb-6">{t(Astro.url, 'hero.eyebrow')}</p>

          <h1 class="text-ink mb-6 text-balance font-display font-bold text-5xl sm:text-6xl lg:text-7xl leading-[0.98] tracking-tight">
            {t(Astro.url, 'hero.headline_start')}{' '}
            <span class="relative inline-block text-blue-200">
              {t(Astro.url, 'hero.headline_trust')}
            </span>
            {t(Astro.url, 'hero.headline_end')}
          </h1>

          <p class="text-ink-100 text-lg sm:text-xl max-w-2xl leading-relaxed mb-8">
            {t(Astro.url, 'hero.subheadline')}
          </p>

          <div class="flex flex-wrap gap-3 mb-10">
            <a href={currentLang === 'en' ? '/en/contact' : '/es/contacto'} class="btn btn-primary">
              {t(Astro.url, 'hero.cta_primary')}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href={currentLang === 'en' ? '/en/experience' : '/es/experience'} class="btn btn-outline">
              {t(Astro.url, 'hero.cta_secondary')}
            </a>
          </div>

          <div class="flex flex-wrap gap-x-6 gap-y-3">
            {['hero.pill_mobile', 'hero.pill_backend', 'hero.pill_cloud', 'hero.pill_ai', 'hero.pill_architecture', 'hero.pill_product'].map((key) => (
              <span class="inline-flex items-center gap-2 text-sm text-ink-200">
                <span class="h-1.5 w-1.5 rounded-full bg-blue-200 shadow-[0_0_14px_var(--color-blue-glow)]" aria-hidden="true"></span>
                {t(Astro.url, key)}
              </span>
            ))}
          </div>
        </div>

        <div class="hidden lg:block lg:col-span-5 xl:col-span-4 xl:col-start-9 relative min-h-[440px]">
          <div class="absolute bottom-0 right-0 w-72 card-glass p-5 shadow-soft-lg">
            <div class="flex items-center justify-between mb-2.5">
              <p class="text-[11px] text-ink-300 uppercase tracking-wider font-semibold">{t(Astro.url, 'hero.currently_label')}</p>
              <span class="w-1.5 h-1.5 rounded-full bg-green animate-pulse" aria-hidden="true"></span>
            </div>
            <p class="text-sm text-ink leading-snug mb-4">{t(Astro.url, 'hero.currently_title')}</p>
            <div class="space-y-2.5 border-y border-border py-4 mb-4">
              {[
                'hero.currently_android',
                'hero.currently_kmp',
                'hero.currently_go',
                'hero.currently_aws',
                'hero.currently_architecture',
                'hero.currently_problem_solver',
              ].map((key) => (
                <div class="flex items-center gap-2.5 text-xs text-ink-200">
                  <span class="h-4 w-4 rounded border border-border-strong bg-white/5" aria-hidden="true"></span>
                  {t(Astro.url, key)}
                </div>
              ))}
            </div>
            <p class="text-xs text-blue-200 font-semibold">{t(Astro.url, 'hero.currently_footer')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-carbon/40">
    <div class="container-page py-12">
      <p class="eyebrow text-center mb-8">{t(Astro.url, 'trust.label')}</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
        <a href="https://www.starbucks.pe/" target="_blank" rel="noopener noreferrer" class="trust-logo-card" aria-label="Starbucks Perú">
          <img src="/images/logos/starbucks.png" alt="Starbucks Perú" class="max-h-10 w-auto object-contain" loading="lazy" />
        </a>
        <a href="https://www.kwema.co/" target="_blank" rel="noopener noreferrer" class="trust-logo-card" aria-label="Kwema">
          <img src="/images/logos/kwema.png" alt="Kwema" class="max-h-9 w-auto object-contain" loading="lazy" />
        </a>
        <a href="https://www.interseguro.pe/" target="_blank" rel="noopener noreferrer" class="trust-logo-card trust-logo-card-light" aria-label="Interseguro">
          <img src="/images/logos/interseguro.svg" alt="Interseguro" class="max-h-10 w-auto object-contain" loading="lazy" />
        </a>
        <a href="https://www.urbaner.com/" target="_blank" rel="noopener noreferrer" class="trust-logo-card trust-logo-card-light" aria-label="Urbaner">
          <img src="/images/logos/urbaner.png" alt="Urbaner" class="max-h-9 w-auto object-contain" loading="lazy" />
        </a>
        <a href="https://zapatillastigre.com/" target="_blank" rel="noopener noreferrer" class="trust-logo-card trust-logo-card-light" aria-label="Zapatillas Tigre">
          <img src="/images/logos/zapatillas-tigre.png" alt="Zapatillas Tigre" class="max-h-14 w-auto object-contain" loading="lazy" />
        </a>
      </div>
    </div>
  </section>

  <section class="container-page py-12 sm:py-16">
    <div class="stats-panel card-glass overflow-hidden">
      <div class="grid grid-cols-2 lg:grid-cols-4">
        {stats.map((stat) => (
          <div class="relative p-7 sm:p-9 text-center">
            <div class="mx-auto mb-5 flex h-10 w-10 items-center justify-center rounded-xl border border-blue/25 bg-blue/10 text-blue-200">
              {stat.icon === 'calendar' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4M16 2v4M3 10h18"/><rect x="3" y="4" width="18" height="18" rx="2"/></svg>}
              {stat.icon === 'cube' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/></svg>}
              {stat.icon === 'users' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>}
              {stat.icon === 'globe' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>}
            </div>
            <p class="font-display font-bold text-4xl sm:text-5xl text-ink tracking-tight">{stat.value}</p>
            <p class="mt-2 text-sm text-ink-200 leading-relaxed">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-12 sm:py-16">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-end mb-10">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-3">{currentLang === 'en' ? 'PHILOSOPHY' : 'FILOSOFÍA'}</p>
        <h2 class="text-balance">{currentLang === 'en' ? 'Product engineering with purpose.' : 'Ingeniería de producto con propósito.'}</h2>
      </div>
      <p class="lg:col-span-5 lg:col-start-8 text-ink-200 leading-relaxed">
        {currentLang === 'en'
          ? 'Yahyr moves across technologies because the real skill is understanding products, reducing risk and creating systems that keep evolving.'
          : 'Yahyr se mueve entre tecnologías porque la habilidad real es entender productos, reducir riesgo y crear sistemas que sigan evolucionando.'}
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-4 sm:gap-5">
      {philosophy.map((item, index) => (
        <article class="card-glass p-7 sm:p-8">
          <p class="text-blue-200 font-display font-bold text-sm mb-8">0{index + 1}</p>
          <h3 class="font-display font-bold text-2xl text-ink mb-3">{item.title}</h3>
          <p class="text-sm text-ink-200 leading-relaxed">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container-page py-12 sm:py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="eyebrow mb-2">{t(Astro.url, 'work.eyebrow')}</p>
        <h2 class="text-balance">{t(Astro.url, 'work.title')}</h2>
      </div>
      <a href={currentLang === 'en' ? '/en/experience' : '/es/experience'} class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-blue-200 hover:text-blue transition-colors">
        {t(Astro.url, 'work.view_all')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid sm:grid-cols-2 xl:grid-cols-5 gap-4 sm:gap-5">
      {selectedWork.map((work) => (
        <article class={`work-card work-card-brand card-glass overflow-hidden group flex min-h-[500px] flex-col transition-colors ${work.accent === 'green' ? 'hover:border-green/50' : work.accent === 'orange' ? 'hover:border-orange/50' : work.accent === 'cyan' ? 'hover:border-accent/50' : work.accent === 'red' ? 'hover:border-error/50' : 'hover:border-blue-200/50'}`}>
          <div class={`relative overflow-hidden border-b border-border p-6 min-h-[210px] flex flex-col justify-between ${work.accent === 'green' ? 'work-visual-green' : work.accent === 'orange' ? 'work-visual-orange' : work.accent === 'cyan' ? 'work-visual-cyan' : work.accent === 'red' ? 'work-visual-red' : 'work-visual-blue'}`}>
            <div class="flex items-start justify-between gap-4">
              <div class={`work-logo-tile ${work.accent === 'cyan' || work.accent === 'red' ? 'work-logo-tile-light' : ''}`}>
                <img
                  src={work.logo}
                  alt={`${work.name} logo`}
                  class="max-h-full max-w-full object-contain"
                  loading="lazy"
                />
              </div>
              <span class="rounded-full border border-white/10 bg-midnight/60 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-ink-100">
                {work.role.split(' · ')[0]}
              </span>
            </div>
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-wider text-ink-200">{work.name}</p>
              <p class="mt-1 font-display text-2xl font-bold leading-tight text-ink">{work.role}</p>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <p class={`text-xs font-semibold uppercase tracking-wider mb-3 ${work.accent === 'green' ? 'text-green' : work.accent === 'orange' ? 'text-orange' : work.accent === 'cyan' ? 'text-accent' : work.accent === 'red' ? 'text-error' : 'text-blue-200'}`}>{work.tag}</p>
            <h3 class="font-display font-bold text-lg text-ink mb-2 leading-snug">{work.title}</h3>
            <p class="text-sm text-ink-200 leading-relaxed mb-4 flex-1">{work.body}</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {work.meta.map((item) => (
                <span class="rounded-md border border-border bg-white/5 px-2 py-1 text-[11px] font-medium text-ink-200">{item}</span>
              ))}
            </div>
            <div class="mt-auto flex flex-wrap gap-2">
              {work.links.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 rounded-md border border-border bg-white/5 px-2.5 py-1.5 text-[11px] font-semibold text-ink-100 transition-colors hover:border-blue/40 hover:text-ink"
                >
                  {link.label}
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container-page py-16 sm:py-24">
    <p class="eyebrow mb-2">{t(Astro.url, 'how.eyebrow')}</p>
    <h2 class="text-balance max-w-2xl mb-16">{t(Astro.url, 'how.title')}</h2>
    <div class="relative">
      <div class="hidden lg:block absolute top-6 left-[8%] right-[8%] h-px border-t border-dashed border-blue/40"></div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-y-10 gap-x-6">
        {howSteps.map((step) => (
          <div class="text-center relative">
            <div class="inline-flex w-12 h-12 rounded-full bg-midnight-100 border border-blue/30 items-center justify-center mb-4 relative z-10">
              <span class="text-blue-200 font-bold text-sm">{step.num}</span>
            </div>
            <p class="font-display font-bold text-base text-ink mb-2">{t(Astro.url, step.titleKey)}</p>
            <p class="text-sm text-ink-200 leading-relaxed">{t(Astro.url, step.descKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="container-page py-16 sm:py-24">
      <div class="closing-panel card-glass p-8 sm:p-12 relative overflow-hidden">
        <div class="grid sm:grid-cols-2 gap-8 items-center relative">
          <div>
            <h2 class="text-balance mb-4">
              {t(Astro.url, 'cta.title')}{' '}
              <span class="text-blue-200">{t(Astro.url, 'cta.title_strong')}</span>.
            </h2>
            <p class="text-ink-200 leading-relaxed">{t(Astro.url, 'cta.body')}</p>
          </div>

          <div class="space-y-3">
            <a href={`mailto:${site.email}`} class="flex items-center gap-3 text-sm text-ink-200 hover:text-ink transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-blue-200" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              {site.email}
            </a>
            <a href={site.socials.find((s) => s.icon === 'linkedin')?.url || 'https://linkedin.com/in/yahyrparedes'} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm text-ink-200 hover:text-ink transition-colors">
              LinkedIn
            </a>
            <a href={site.socials.find((s) => s.icon === 'github')?.url || 'https://github.com/yahyrparedes'} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-sm text-ink-200 hover:text-ink transition-colors">
              GitHub
            </a>
            <a href={currentLang === 'en' ? '/en/contact' : '/es/contacto'} class="btn btn-primary mt-5">
              {t(Astro.url, 'cta.cta_primary')}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
