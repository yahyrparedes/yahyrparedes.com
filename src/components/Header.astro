---
import { site } from '@data/site';
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + '/');
---

<header class="sticky top-0 z-50 bg-cream/85 backdrop-blur-md border-b border-cream-200/60">
  <div class="container-page flex items-center justify-between h-16 sm:h-18">
    <!-- Logo serif italic estilo "Ali Abdaal" -->
    <a href="/" class="flex items-center gap-2.5 group">
      <span class="font-display font-medium italic text-xl sm:text-2xl text-ink-300 tracking-tight">
        Yahyr Paredes
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
      <a
        href="/sobre-mi"
        class:list={[
          'px-3.5 py-2 text-sm font-medium rounded-full transition-all',
          isActive('/sobre-mi') ? 'text-ink-300 bg-cream-200' : 'text-ink-200 hover:text-ink-300 hover:bg-cream-200/60',
        ]}
      >
        Sobre mí
      </a>
      <a
        href="/perfil"
        class:list={[
          'px-3.5 py-2 text-sm font-medium rounded-full transition-all',
          isActive('/perfil') ? 'text-ink-300 bg-cream-200' : 'text-ink-200 hover:text-ink-300 hover:bg-cream-200/60',
        ]}
      >
        Perfil
      </a>
      <a
        href="/servicios"
        class:list={[
          'px-3.5 py-2 text-sm font-medium rounded-full transition-all',
          isActive('/servicios') ? 'text-ink-300 bg-cream-200' : 'text-ink-200 hover:text-ink-300 hover:bg-cream-200/60',
        ]}
      >
        Servicios
      </a>
      <a
        href="/plugins"
        class:list={[
          'px-3.5 py-2 text-sm font-medium rounded-full transition-all',
          isActive('/plugins') ? 'text-ink-300 bg-cream-200' : 'text-ink-200 hover:text-ink-300 hover:bg-cream-200/60',
        ]}
      >
        Plugins
      </a>
      <a
        href="/blog"
        class:list={[
          'px-3.5 py-2 text-sm font-medium rounded-full transition-all',
          isActive('/blog') ? 'text-ink-300 bg-cream-200' : 'text-ink-200 hover:text-ink-300 hover:bg-cream-200/60',
        ]}
      >
        Blog
      </a>
    </nav>

    <!-- CTA: pill rounded-full estilo Subscribe -->
    <a
      href="/contacto"
      class="inline-flex items-center gap-1.5 px-5 py-2.5 text-sm font-semibold rounded-full bg-coral text-cream-100 hover:bg-coral-300 transition-all shadow-sm"
    >
      Hablemos
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</header>
