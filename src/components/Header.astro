---
import { site } from '@data/site';
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + '/');
---

<header class="sticky top-0 z-50 bg-cream-100/90 backdrop-blur-md border-b border-sage-100">
  <div class="container-page flex items-center justify-between h-16 sm:h-18">
    <!-- Logo + Name -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/images/logo.png"
        alt={site.name}
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-lg object-cover ring-2 ring-sage-100 group-hover:ring-sage-300 transition-all"
        width="40"
        height="40"
        loading="eager"
      />
      <div class="hidden sm:block">
        <p class="font-display font-bold text-base text-ink-300 leading-tight">{site.name}</p>
        <p class="text-xs text-ink-100 leading-tight">{site.role}</p>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      <a
        href="/sobre-mi"
        class:list={[
          'px-3 py-2 text-sm font-medium rounded-lg transition-colors',
          isActive('/sobre-mi') ? 'text-ink-300 bg-sage-50' : 'text-ink-200 hover:text-ink-300 hover:bg-sage-50',
        ]}
      >
        Sobre mí
      </a>
      <a
        href="/perfil"
        class:list={[
          'px-3 py-2 text-sm font-medium rounded-lg transition-colors',
          isActive('/perfil') ? 'text-ink-300 bg-sage-50' : 'text-ink-200 hover:text-ink-300 hover:bg-sage-50',
        ]}
      >
        Perfil
      </a>
      <a
        href="/servicios"
        class:list={[
          'px-3 py-2 text-sm font-medium rounded-lg transition-colors',
          isActive('/servicios') ? 'text-ink-300 bg-sage-50' : 'text-ink-200 hover:text-ink-300 hover:bg-sage-50',
        ]}
      >
        Servicios
      </a>
      <a
        href="/plugins"
        class:list={[
          'px-3 py-2 text-sm font-medium rounded-lg transition-colors',
          isActive('/plugins') ? 'text-ink-300 bg-sage-50' : 'text-ink-200 hover:text-ink-300 hover:bg-sage-50',
        ]}
      >
        Plugins
      </a>
      <a
        href="/blog"
        class:list={[
          'px-3 py-2 text-sm font-medium rounded-lg transition-colors',
          isActive('/blog') ? 'text-ink-300 bg-sage-50' : 'text-ink-200 hover:text-ink-300 hover:bg-sage-50',
        ]}
      >
        Blog
      </a>
    </nav>

    <!-- CTA -->
    <a
      href="/contacto"
      class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-xl bg-amber-300 text-ink-300 hover:bg-amber-400 transition-colors shadow-sm shadow-amber-300/30"
    >
      <span class="hidden sm:inline">Hablemos</span>
      <span class="sm:hidden">→</span>
    </a>
  </div>
</header>
