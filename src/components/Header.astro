---
import { site } from '@data/site.ts';
import { t, getLangFromUrl, getLocalizedPath } from '@i18n/ui.ts';
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import '@styles/global.css';

const currentPath = Astro.url.pathname;
const currentLang = getLangFromUrl(Astro.url);
const normalizePath = (value: string) => (value.endsWith('/') && value !== '/' ? value.slice(0, -1) : value);
const isActive = (path: string) => {
  const normalizedCurrentPath = normalizePath(currentPath);
  const normalizedPath = normalizePath(path);
  if (normalizedPath === '/') return normalizedCurrentPath === `/${currentLang}` || normalizedCurrentPath === '/';
  return normalizedCurrentPath.startsWith(`/${currentLang}${normalizedPath}`) || normalizedCurrentPath === normalizedPath;
};

const navItems = [
  { key: 'nav.home', href: getLocalizedPath('home', currentLang) },
  { key: 'nav.about', href: getLocalizedPath('about', currentLang) },
  { key: 'nav.experience', href: getLocalizedPath('experience', currentLang) },
  { key: 'nav.services', href: getLocalizedPath('services', currentLang) },
  { key: 'nav.open_source', href: getLocalizedPath('openSource', currentLang) },
  { key: 'nav.blog', href: getLocalizedPath('blog', currentLang) },
  { key: 'nav.contact', href: getLocalizedPath('contact', currentLang) },
];
---

<header class="sticky top-0 z-50 bg-midnight/95 backdrop-blur-md border-b border-blue/30 shadow-sm shadow-midnight/50">
  <div class="container-page flex items-center justify-between h-16 sm:h-18">
    <!-- Logo -->
    <a href={getLocalizedPath('home', currentLang)} class="flex items-center gap-2.5 group">
      <img
        src="/images/logo.png"
        alt={site.name}
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full object-cover ring-1 ring-border group-hover:ring-blue-200 transition-all"
        width="40"
        height="40"
        loading="eager"
      />
      <div class="hidden sm:block leading-tight">
        <p class="font-display font-bold text-sm tracking-tight text-ink">
          {site.name.toUpperCase()}
        </p>
        <p class="text-xs text-blue-200 font-medium">
          {t(Astro.url, 'hero.eyebrow')}
        </p>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-0.5" aria-label="Navegación principal">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'nav-link',
            isActive(item.href) ? 'active' : '',
          ]}
        >
          {t(Astro.url, item.key)}
        </a>
      ))}
    </nav>

    <!-- Right: theme + language toggle + CTA -->
    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageToggle />
      <ThemeToggle />
      <a
        href={getLocalizedPath('contact', currentLang)}
        class="hidden sm:inline-flex btn btn-outline"
      >
        {t(Astro.url, 'nav.cta')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <!-- Mobile menu button -->
      <button
        type="button"
        class="lg:hidden p-2 -mr-2 text-ink-200 hover:text-ink"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
      </button>
    </div>
  </div>
</header>
