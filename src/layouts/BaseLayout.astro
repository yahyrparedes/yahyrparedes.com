---
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { buildMeta, personJsonLd, webSiteJsonLd, type SeoMeta } from '@lib/seo';
import { site } from '@data/site';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'profile' | 'article';
  publishedTime?: string;
  author?: string;
  noindex?: boolean;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title = site.tagline,
  description = site.bio,
  image,
  type = 'website',
  publishedTime,
  author,
  noindex = false,
  showHeader = true,
  showFooter = true,
} = Astro.props;

const meta = buildMeta({ title, description, image, type, publishedTime, author, noindex });

const sameAs = site.socials.map((s) => s.url).filter((u) => u.startsWith('http'));

const personLd = personJsonLd({
  name: site.name,
  handle: site.handle,
  bio: site.bio,
  image: site.image || '/images/logo.png',
  email: site.email,
  sameAs,
});

const siteLd = webSiteJsonLd();
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#5C6B5A" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    {meta.noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{meta.fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content="Yahyr Paredes, software developer, Android, Kotlin, Java, Spring Boot, freelance, Jaén, Andalucía, plugins PrestaShop, SEO" />
    <link rel="canonical" href={canonical} />

    <meta http-equiv="content-language" content="es-ES" />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:type" content={meta.type} />
    <meta property="og:title" content={meta.fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={meta.fullUrl} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={meta.ogImage} />

    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jakarta-variable.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly content" />
    <link rel="author" type="text/plain" href="/humans.txt" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  </head>
  <body>
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>
