---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site';
---

<BaseLayout
  title="Sobre mí"
  description={`Conoce a ${site.name} · Software developer basado en ${site.location}.`}
  type="profile"
>
  <article class="container-page py-12 sm:py-16 max-w-4xl">
    <header class="mb-10 fade-in-up">
      <p class="text-sm font-medium text-sage-500 mb-2">{site.location}, {site.country}</p>
      <h1 class="font-display font-bold text-4xl sm:text-5xl text-ink-300 text-balance">
        {site.name}
      </h1>
      <p class="mt-3 text-xl text-ink-100 text-pretty">{site.role}</p>
    </header>

    <div class="prose prose-stone max-w-none fade-in-up stagger-2">
      <div class="text-ink-200 leading-relaxed text-pretty space-y-5 text-lg">
        {site.longBio.split('\n\n').map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <!-- Galería de fotos -->
      <div class="mt-12">
        <h2 class="font-display font-bold text-2xl text-ink-300 mb-6">Mi vida en España</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
          {site.photos[0]?.photos.map((photo) => (
            <figure class="rounded-xl overflow-hidden bg-sage-50 aspect-square">
              <img
                src={photo.src}
                alt={photo.alt}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              {photo.caption && (
                <figcaption class="text-xs text-ink-100 mt-2 text-center">{photo.caption}</figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>

      <!-- Stack -->
      <div class="mt-12">
        <h2 class="font-display font-bold text-2xl text-ink-300 mb-6">Stack</h2>
        <div class="space-y-4">
          {site.skills.map((cat) => (
            <div>
              <h3 class="text-sm font-semibold text-ink-300 mb-2">{cat.category}</h3>
              <div class="flex flex-wrap gap-2">
                {cat.items.map((item) => (
                  <span class="px-3 py-1 text-sm bg-sage-50 text-ink-200 rounded-full border border-sage-100">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Idiomas -->
      <div class="mt-12">
        <h2 class="font-display font-bold text-2xl text-ink-300 mb-4">Idiomas</h2>
        <ul class="space-y-2">
          {site.languages.map((lang) => (
            <li class="flex items-center gap-3">
              <span class="font-medium text-ink-300">{lang.name}</span>
              <span class="text-ink-100">·</span>
              <span class="text-ink-200">{lang.level}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 text-center">
      <a
        href="/contacto"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-300 text-ink-300 font-semibold hover:bg-amber-400 transition-all shadow-md shadow-amber-300/30"
      >
        Trabajemos juntos
      </a>
    </div>
  </article>
</BaseLayout>
