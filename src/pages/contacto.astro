---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site';
---

<BaseLayout
  title="Contacto"
  description={`Hablemos de tu proyecto. ${site.role} basado en ${site.location}.`}
>
  <article class="container-page py-12 sm:py-16 max-w-4xl">
    <header class="text-center mb-12 fade-in-up">
      <h1 class="font-display font-bold text-4xl sm:text-5xl text-ink-300 text-balance">
        Hablemos
      </h1>
      <p class="mt-3 text-lg text-ink-200 text-pretty">
        Cuéntame de tu proyecto. Respondo en 24-48h.
      </p>
    </header>

    <div class="grid md:grid-cols-2 gap-6 sm:gap-10">
      <!-- Form -->
      <form
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
        role="form"
        aria-label="Formulario de contacto"
        data-form-type="contact"
        class="space-y-4 p-6 sm:p-8 bg-cream-100 rounded-2xl border border-sage-100 fade-in-up stagger-2"
      >
        <div>
          <label for="contact-name" class="block text-sm font-semibold text-ink-300 mb-1.5">Nombre</label>
          <input
            type="text"
            id="contact-name"
            name="contact-name"
            required
            autocomplete="name"
            aria-label="Tu nombre completo"
            data-lpignore="true"
            data-1p-ignore="true"
            data-form-type="contact"
            class="w-full px-4 py-2.5 rounded-lg border border-sage-200 bg-cream-100 text-ink-300 focus:border-sage-400 focus:outline-none transition-colors"
          />
        </div>
        <div>
          <label for="contact-email" class="block text-sm font-semibold text-ink-300 mb-1.5">Email</label>
          <input
            type="email"
            id="contact-email"
            name="contact-email"
            required
            autocomplete="email"
            aria-label="Tu dirección de email para responder"
            data-lpignore="true"
            data-1p-ignore="true"
            data-form-type="contact"
            class="w-full px-4 py-2.5 rounded-lg border border-sage-200 bg-cream-100 text-ink-300 focus:border-sage-400 focus:outline-none transition-colors"
          />
        </div>
        <div>
          <label for="project-type" class="block text-sm font-semibold text-ink-300 mb-1.5">Tipo de proyecto</label>
          <select
            id="project-type"
            name="project-type"
            data-form-type="contact"
            class="w-full px-4 py-2.5 rounded-lg border border-sage-200 bg-cream-100 text-ink-300 focus:border-sage-400 focus:outline-none transition-colors"
          >
            <option value="">— Selecciona —</option>
            <option value="webs">Web de alto rendimiento</option>
            <option value="apps">App móvil</option>
            <option value="ecosistema">Ecosistema completo</option>
            <option value="hot-fixes">Hot fixes / mejoras</option>
            <option value="ai-rescue">AI Rescue</option>
            <option value="otro">Otro</option>
          </select>
        </div>
        <div>
          <label for="contact-message" class="block text-sm font-semibold text-ink-300 mb-1.5">Mensaje</label>
          <textarea
            id="contact-message"
            name="contact-message"
            rows="5"
            required
            aria-label="Cuéntame sobre tu proyecto"
            data-lpignore="true"
            data-1p-ignore="true"
            data-form-type="contact"
            class="w-full px-4 py-2.5 rounded-lg border border-sage-200 bg-cream-100 text-ink-300 focus:border-sage-400 focus:outline-none transition-colors resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          data-form-type="contact"
          class="w-full px-6 py-3 rounded-xl bg-amber-300 text-ink-300 font-semibold hover:bg-amber-400 transition-all shadow-md shadow-amber-300/30"
        >
          Enviar mensaje
        </button>
        <p class="text-xs text-ink-100 text-center">
          Al enviar se abrirá tu cliente de email. O escríbeme directo a <a href={`mailto:${site.email}`} class="underline">{site.email}</a>
        </p>
      </form>

      <!-- Info -->
      <div class="space-y-6 fade-in-up stagger-3">
        <div>
          <h2 class="font-display font-bold text-lg text-ink-300 mb-3">Email directo</h2>
          <a href={`mailto:${site.email}`} class="text-ink-200 hover:text-ink-300 underline">
            {site.email}
          </a>
        </div>

        <div>
          <h2 class="font-display font-bold text-lg text-ink-300 mb-3">Ubicación</h2>
          <p class="text-ink-200">{site.location}, {site.country}</p>
          <p class="text-sm text-ink-100 mt-1">Disponible remoto en toda España y EU</p>
        </div>

        <div>
          <h2 class="font-display font-bold text-lg text-ink-300 mb-3">Tiempo de respuesta</h2>
          <p class="text-ink-200">24-48h en días laborables</p>
        </div>

        <div>
          <h2 class="font-display font-bold text-lg text-ink-300 mb-3">Sígueme</h2>
          <div class="flex flex-wrap gap-3">
            {site.socials.map((s) => (
              <a
                href={s.url}
                target={s.url.startsWith('http') ? '_blank' : undefined}
                rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="px-4 py-2 text-sm rounded-lg bg-sage-50 text-ink-200 border border-sage-100 hover:bg-sage-100 transition-colors"
              >
                {s.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
