---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site';
---

<BaseLayout
  title="Perfil profesional"
  description={`CV interactivo de ${site.name} · ${site.role} con ${site.experience.length}+ años de experiencia.`}
  type="profile"
>
  <article class="container-page py-12 sm:py-16 max-w-4xl">
    <header class="mb-12 fade-in-up">
      <h1 class="font-display font-bold text-4xl sm:text-5xl text-ink-300 text-balance">
        Perfil profesional
      </h1>
      <p class="mt-3 text-lg text-ink-200 text-pretty">
        Mi trayectoria,skills, y proyectos. Sin PDFs aburridos.
      </p>
    </header>

    <!-- EXPERIENCIA -->
    <section class="mb-16 fade-in-up stagger-2">
      <h2 class="font-display font-bold text-2xl text-ink-300 mb-6 flex items-center gap-2">
        <span class="inline-block w-1.5 h-7 bg-sage-400 rounded-full"></span>
        Experiencia
      </h2>

      <div class="relative pl-8 sm:pl-12">
        <!-- Vertical line -->
        <div class="absolute left-2 sm:left-4 top-2 bottom-2 w-px bg-sage-200"></div>

        <ol class="space-y-10">
          {site.experience.map((exp, i) => (
            <li class="relative">
              <!-- Dot -->
              <div class="absolute -left-[26px] sm:-left-[34px] top-1.5 w-3 h-3 sm:w-4 sm:h-4 rounded-full bg-sage-400 ring-4 ring-cream-100"></div>

              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                <h3 class="font-display font-bold text-lg text-ink-300">{exp.role}</h3>
                <span class="text-ink-100">·</span>
                {exp.url ? (
                  <a href={exp.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-sage-500 hover:text-sage-600">
                    {exp.company} ↗
                  </a>
                ) : (
                  <span class="font-semibold text-sage-500">{exp.company}</span>
                )}
              </div>
              <p class="text-sm text-ink-100 mb-3">
                {exp.period} · {exp.location}
              </p>
              <p class="text-ink-200 text-pretty leading-relaxed mb-3">{exp.description}</p>
              <ul class="space-y-1.5 text-sm text-ink-200">
                {exp.highlights.map((h) => (
                  <li class="flex items-start gap-2">
                    <span class="text-sage-400 mt-1.5">▸</span>
                    <span class="flex-1">{h}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- EDUCACIÓN -->
    <section class="mb-16 fade-in-up stagger-3">
      <h2 class="font-display font-bold text-2xl text-ink-300 mb-6 flex items-center gap-2">
        <span class="inline-block w-1.5 h-7 bg-sage-400 rounded-full"></span>
        Educación
      </h2>
      <div class="space-y-4">
        {site.education.map((edu) => (
          <div class="p-5 bg-cream-100 rounded-xl border border-sage-100">
            <h3 class="font-display font-bold text-lg text-ink-300">{edu.degree}</h3>
            <p class="text-sm text-sage-500 font-medium mt-1">{edu.institution}</p>
            <p class="text-xs text-ink-100 mt-1">{edu.period}</p>
            {edu.description && <p class="mt-3 text-ink-200 text-pretty">{edu.description}</p>}
          </div>
        ))}
      </div>
    </section>

    <!-- PROYECTOS -->
    <section class="mb-16 fade-in-up stagger-4">
      <h2 class="font-display font-bold text-2xl text-ink-300 mb-6 flex items-center gap-2">
        <span class="inline-block w-1.5 h-7 bg-sage-400 rounded-full"></span>
        Proyectos destacados
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {site.projects.map((p) => (
          <div class="p-5 bg-cream-100 rounded-xl border border-sage-100 hover:border-sage-300 transition-colors">
            <div class="flex items-start justify-between mb-2">
              <h3 class="font-display font-bold text-ink-300">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="hover:text-sage-500">
                    {p.name} ↗
                  </a>
                ) : (
                  <span>{p.name}</span>
                )}
              </h3>
              <span class="text-xs text-ink-100 font-medium px-2 py-0.5 rounded bg-sage-50">{p.year}</span>
            </div>
            <p class="text-sm text-ink-200 text-pretty">{p.description}</p>
            <span class="inline-block mt-3 text-xs font-medium px-2 py-0.5 rounded bg-amber-100 text-amber-500">
              {p.category}
            </span>
          </div>
        ))}
      </div>
    </section>

    <div class="mt-16 text-center">
      <a
        href="/contacto"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-300 text-ink-300 font-semibold hover:bg-amber-400 transition-all shadow-md shadow-amber-300/30"
      >
        Hablemos de un proyecto
      </a>
    </div>
  </article>
</BaseLayout>
