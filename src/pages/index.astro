---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Yahyr Paredes"
  description="Yahyr Paredes · Product Engineer"
>
  <!--
    Esta página nunca se muestra.
    Detecta el idioma del navegador (o el guardado en localStorage)
    y redirige al usuario a /es/ o /en/ sin mostrar contenido visible.

    Estrategia:
    1. Script inline en <head> redirige INMEDIATAMENTE al cargar
    2. <noscript> muestra un meta-refresh al idioma por defecto
    3. Si por alguna razón no redirige (JS falla, no-lang match),
       la página es invisible (sin contenido visible)
  -->

  <!-- Empty body intencionalmente: el redirect ocurre antes del primer paint -->
  <div hidden aria-hidden="true"></div>

  <!-- Fallback si JS está deshabilitado: meta refresh a /es/ -->
  <noscript>
    <meta http-equiv="refresh" content="0; url=/es/" />
  </noscript>

  <script is:inline>
    (function () {
      try {
        // 1. Idioma guardado tiene prioridad
        var saved = localStorage.getItem('site-lang');

        // 2. Si no, detectar del navegador (revisar TODOS los idiomas, no solo el primero)
        var supported = ['es', 'en'];
        var defaultLang = 'es';
        var lang = null;

        if (saved && supported.indexOf(saved) !== -1) {
          lang = saved;
        } else {
          var langs = navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language];
          for (var i = 0; i < langs.length; i++) {
            var code = String(langs[i] || '').toLowerCase().split('-')[0];
            if (supported.indexOf(code) !== -1) {
              lang = code;
              break;
            }
          }
        }

        // 3. Si no encontramos match, usar español (default)
        if (!lang) lang = defaultLang;

        // 4. Redirigir INMEDIATAMENTE sin mostrar contenido
        window.location.replace('/' + lang + '/');
      } catch (e) {
        // Si algo falla (localStorage bloqueado, etc.), ir a español
        window.location.replace('/es/');
      }
    })();
  </script>
</BaseLayout>
