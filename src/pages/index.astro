---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Yahyr Paredes"
  description="Choose your language / Elige tu idioma"
  showHeader={false}
  showFooter={false}
>
  <section class="min-h-screen flex items-center justify-center px-6">
    <div class="card max-w-xl w-full p-8 sm:p-10 text-center">
      <p class="eyebrow mb-4">Language / Idioma</p>
      <h1 class="mb-4 text-balance">Choose your language</h1>
      <p class="text-ink-100 mb-8">Selecciona tu idioma para continuar.</p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/es/" class="btn btn-primary justify-center">Español</a>
        <a href="/en/" class="btn btn-outline justify-center">English</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('site-lang');
        var browser = navigator.languages && navigator.languages.length ? navigator.languages[0] : navigator.language;
        var lang = saved || (browser && String(browser).toLowerCase().startsWith('en') ? 'en' : 'es');
        if (lang === 'en' || lang === 'es') {
          window.location.replace('/' + lang + '/');
        }
      } catch (e) {}
    })();
  </script>
</BaseLayout>
