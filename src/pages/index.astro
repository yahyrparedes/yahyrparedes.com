---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site';

const services = site.services.slice(0, 3);
const featuredPlugins = site.plugins.slice(0, 4);

const stats = [
  { value: '+9', unit: 'años', label: 'construyendo software' },
  { value: '5', unit: 'plugins', label: 'open source para PrestaShop' },
  { value: '1M+', unit: 'descargas', label: 'en apps que mantengo' },
  { value: '2', unit: 'trainees', label: 'hoy Tech Lead y SRE' },
];

// SVG icons inline (currentColor → heredan color del CSS padre)
const iconWeb = `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2.5"/><path d="M2 11h20"/><path d="M8 21h8"/><path d="M12 17v4"/><path d="M9 7l-2 2 2 2"/><path d="M13 7l2 2-2 2"/></svg>`;
const iconMobile = `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/><path d="M9 5h6"/><circle cx="12" cy="12" r="2.5"/><path d="M9.5 9.5l-1 1"/><path d="M14.5 14.5l1 1"/><path d="M14.5 9.5l1 1"/><path d="M9.5 14.5l-1 1"/></svg>`;
const iconStack = `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/><path d="M3 18l9 5 9-5"/></svg>`;
const iconWrench = `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a4 4 0 015.66 5.66l-1.42-1.42a2 2 0 00-2.82 0L14.7 12l-7.07 7.07a2 2 0 01-2.83 0L3.86 18.13a2 2 0 010-2.83L11 8l1.41-1.41a2 2 0 000-2.82L11 2.3a4 4 0 013.7 4z"/><path d="M9 13l2 2"/></svg>`;
const iconSparkles = `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.6a2.5 2.5 0 001.6 1.6L20 11l-4.6 1.8a2.5 2.5 0 00-1.6 1.6L12 19l-1.8-4.6a2.5 2.5 0 00-1.6-1.6L4 11l4.6-1.8a2.5 2.5 0 001.6-1.6L12 3z"/><path d="M19 17l.6 1.5a1 1 0 00.6.6L21.7 19.7l-1.5.6a1 1 0 00-.6.6L19 22l-.6-1.5a1 1 0 00-.6-.6L16.3 19.3l1.5-.6a1 1 0 00.6-.6L19 17z"/></svg>`;

// Cards 2-col estilo Ali Abdaal: imagen/icono + headline + texto
const servicesBig = [
  {
    slug: 'apps',
    name: 'Apps móviles',
    icon: iconMobile,
    bg: 'bg-cream-100',
    text: 'text-ink-300',
    text2: 'Hey',  // palabra destacada que va con swoop
    headline: 'Apps que la gente quiere usar.',
    body: 'Android nativo con Kotlin y Jetpack Compose, iOS con Swift, o KMP si quieres compartir lógica. Diseño UX, publicación en stores, mantenimiento mensual.',
  },
  {
    slug: 'webs',
    name: 'Webs de alto rendimiento',
    icon: iconWeb,
    bg: 'bg-cream-100',
    text: 'text-ink-300',
    text2: 'Rápidas',
    headline: 'Webs que cargan en menos de un segundo.',
    body: 'Astro, Next.js o lo que tu proyecto necesite. Static-first para velocidad extrema, SEO técnico completo, diseño mobile-first. Deploy con Coolify + Cloudflare.',
  },
  {
    slug: 'ecosistema',
    name: 'Ecosistema completo',
    icon: iconStack,
    bg: 'bg-cream-100',
    text: 'text-ink-300',
    text2: 'Conectado',
    headline: 'Web + backend + infra + apps.',
    body: 'Para proyectos que necesitan toda la stack: AWS o GCP, arquitectura como código, CI/CD, monitoring, runbooks. Pago por milestones entregables.',
  },
  {
    slug: 'hot-fixes',
    name: 'Hot fixes y mejoras',
    icon: iconWrench,
    bg: 'bg-cream-100',
    text: 'text-ink-300',
    text2: 'Evoluciona',
    headline: 'Tu proyecto ya está en producción.',
    body: 'Auditoría rápida, refactor sin breaking changes, nuevas features integradas al código existente, mejoras de performance. Code review del equipo.',
  },
  {
    slug: 'ai-rescue',
    name: 'AI Rescue',
    icon: iconSparkles,
    bg: 'bg-cream-100',
    text: 'text-ink-300',
    text2: 'Rescata',
    headline: 'Tu proyecto AI no funciona. Te lo arreglo.',
    body: 'Si contrataste a alguien que programa con IA o lo hiciste tú mismo, y tienes un Frankenstein que se cae, te lo rescato. Auditoría, refactor, tests, deploy.',
  },
];
---

<BaseLayout
  title={site.tagline}
  description={site.bio}
  type="profile"
>
  <!-- HERO — Ali Abdaal style: serif italic, blob decorativo, swoop hand-drawn -->
  <section class="container-page pt-12 sm:pt-20 pb-16 sm:pb-24 relative overflow-hidden">
    <!-- Blobs decorativos de fondo -->
    <div class="absolute top-20 right-0 w-96 h-96 rounded-full bg-lilac/30 blur-3xl -z-0" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-10 w-72 h-72 rounded-full bg-butter/20 blur-3xl -z-0" aria-hidden="true"></div>

    <div class="relative grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <!-- Texto -->
      <div class="lg:col-span-7 order-2 lg:order-1">
        <!-- Pill badge estilo "Join 230k+" -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-coral text-cream-100 mb-6 fade-in-up">
          <span class="w-1.5 h-1.5 rounded-full bg-cream-100 animate-pulse" aria-hidden="true"></span>
          <span class="text-xs font-semibold uppercase tracking-wider">Disponible · {site.location}</span>
        </div>

        <h1 class="font-display font-semibold text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-ink-300 text-balance leading-[1.02] tracking-tight fade-in-up stagger-1">
          Construyo software<br />
          que <span class="relative inline-block italic">de verdad
            <svg
              class="absolute pointer-events-none -z-10 text-coral"
              style="left: -6%; right: -6%; top: -8%; width: 112%; height: 116%;"
              viewBox="0 0 280 90"
              fill="none"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M 18 52 C 12 28, 60 8, 140 12 C 220 16, 268 30, 262 50 C 256 70, 200 78, 130 74 C 70 70, 30 64, 18 52"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                fill="none"
              />
              <path
                d="M 18 52 C 22 58, 40 64, 70 68"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                fill="none"
              />
            </svg>
          </span><br />
          se usa.
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-ink-200 max-w-2xl text-pretty leading-relaxed fade-in-up stagger-2">
          Mobile, backend y cloud. {site.bio.split('.').slice(0, 2).join('.')}.
        </p>

        <!-- CTAs: pill sky + outline ink -->
        <div class="mt-8 flex flex-wrap items-center gap-3 fade-in-up stagger-3">
          <a
            href="/contacto"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-ink-300 text-cream-100 font-semibold hover:bg-ink transition-all shadow-sm hover:shadow-md"
          >
            Hablemos de tu proyecto
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="/perfil"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-transparent text-ink-300 font-semibold border-2 border-ink-300/20 hover:border-ink-300 hover:bg-ink-300/5 transition-all"
          >
            Ver perfil
          </a>
        </div>

        <!-- Social pills -->
        <div class="mt-10 flex items-center gap-2 text-sm text-ink-100 fade-in-up stagger-4">
          <span class="hidden sm:inline">Conecta:</span>
          {site.socials.map((s) => (
            <a
              href={s.url}
              target={s.url.startsWith('http') ? '_blank' : undefined}
              rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-cream-100 text-ink-200 hover:text-coral hover:bg-coral-100 transition-all"
              aria-label={s.label}
            >
              {s.icon === 'linkedin' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {s.icon === 'github' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
              )}
              {s.icon === 'email' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Foto con blob butter + badge flotante (estilo Ali Abdaal) -->
      <div class="lg:col-span-5 order-1 lg:order-2 fade-in-up relative">
        <div class="relative aspect-square max-w-md mx-auto">
          <!-- Blob butter detrás de la foto -->
          <div class="absolute inset-4 rounded-full bg-butter/60 -z-10" aria-hidden="true"></div>
          <!-- Blob lila más pequeño -->
          <div class="absolute -bottom-6 -right-6 w-40 h-40 rounded-full bg-lilac -z-10" aria-hidden="true"></div>

          <img
            src="/images/personal-1.png"
            alt={site.name}
            class="relative w-full h-full object-cover rounded-full shadow-2xl shadow-ink-300/20"
            width="500"
            height="500"
            loading="eager"
          />

          <!-- Badge flotante -->
          <div class="absolute -bottom-4 -left-4 sm:-left-8 bg-cream-100 rounded-2xl shadow-xl shadow-ink-300/10 px-4 py-3 flex items-center gap-3 border-4 border-cream-100">
            <div class="w-10 h-10 rounded-full bg-coral-100 flex items-center justify-center">
              <span class="text-xl">🇪🇸</span>
            </div>
            <div>
              <p class="text-xs font-semibold text-ink-300 font-display italic">Andalucía, España</p>
              <p class="text-xs text-ink-100">Perú → Jaén</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS — editorial, números grandes serif -->
  <section class="bg-cream-100">
    <div class="container-page py-12 sm:py-16">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10">
        {stats.map((s) => (
          <div class="text-center sm:text-left">
            <div class="flex items-baseline gap-1.5 justify-center sm:justify-start">
              <span class="font-display font-semibold text-5xl sm:text-6xl text-ink-300 tracking-tight">
                {s.value}
              </span>
              <span class="text-base sm:text-lg text-coral font-display italic">{s.unit}</span>
            </div>
            <p class="mt-2 text-sm text-ink-200 text-pretty leading-relaxed">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICIOS — Ali Abdaal "How Can I Help You?" style: cards 2-col con icono + headline + body -->
  <section class="container-page py-16 sm:py-24 relative">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <h2 class="font-display font-medium text-4xl sm:text-5xl md:text-6xl text-ink-300 text-balance">
        ¿Cómo puedo<br />
        <span class="relative inline-block italic">ayudarte
          <svg
            class="absolute pointer-events-none -z-10 text-sky-300"
            style="left: -6%; right: -6%; top: -8%; width: 112%; height: 116%;"
            viewBox="0 0 280 90"
            fill="none"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M 18 52 C 12 28, 60 8, 140 12 C 220 16, 268 30, 262 50 C 256 70, 200 78, 130 74 C 70 70, 30 64, 18 52"
              stroke="currentColor"
              stroke-width="3.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              fill="none"
            />
          </svg>
        </span>?
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 sm:gap-6">
      {servicesBig.map((s, i) => (
        <a
          href={`/servicios/${s.slug}`}
          class={`group p-8 sm:p-10 ${s.bg} rounded-3xl border-2 border-cream-200 hover:border-coral/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink-300/5 fade-in-up`}
          style={`animation-delay: ${0.05 * (i + 1)}s`}
        >
          <div class={`w-16 h-16 rounded-2xl bg-cream-200 ${s.text} flex items-center justify-center mb-6 group-hover:bg-coral-100 group-hover:text-coral transition-all`}>
            <span class="[&>svg]:w-7 [&>svg]:h-7" set:html={s.icon} />
          </div>
          <p class="text-xs font-display italic text-coral mb-2">{s.text2}</p>
          <h3 class="font-display font-semibold text-2xl sm:text-3xl text-ink-300 mb-3 text-balance">
            {s.headline}
          </h3>
          <p class="text-base text-ink-200 text-pretty leading-relaxed">
            {s.body}
          </p>
          <p class="mt-6 text-sm font-semibold text-coral inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
            Ver detalles
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- PLUGINS PREVIEW — mantiene el estilo Tiger Suite, sin swoops -->
  <section class="bg-cream-100">
    <div class="container-page py-12 sm:py-16">
      <div class="flex items-end justify-between mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-ink-300/5 text-ink-300 text-xs font-display italic mb-3">
            🐯 Tiger Suite
          </div>
          <h2 class="font-display font-semibold text-3xl sm:text-4xl text-ink-300 text-balance">
            5 plugins open source<br />para PrestaShop
          </h2>
          <p class="mt-3 text-ink-200 text-pretty max-w-xl">
            Marketing suite completa. Alternativa a los €200/mes europeos.
          </p>
        </div>
        <a href="/plugins" class="hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold text-coral hover:text-coral-300 transition-colors">
          Ver la suite
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
        {featuredPlugins.map((p, i) => (
          <a
            href={`/plugins/${p.slug}`}
            class="group p-6 bg-cream rounded-2xl border-2 border-cream-200 hover:border-coral/30 transition-all fade-in-up"
            style={`animation-delay: ${0.05 * (i + 1)}s`}
          >
            <div class="text-3xl mb-3">{p.icon}</div>
            <h3 class="font-display font-semibold text-lg text-ink-300 mb-1">{p.name.replace('Tiger ', '')}</h3>
            <p class="text-sm text-ink-200 text-pretty leading-relaxed line-clamp-2">{p.tagline}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BLOG PREVIEW (próximamente) -->
  <section class="container-page py-16 sm:py-24">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-block px-3 py-1 rounded-full bg-butter/30 text-ink-300 text-xs font-display italic mb-3">
        Próximamente
      </div>
      <h2 class="font-display font-medium text-3xl sm:text-4xl text-ink-300 text-balance">
        Blog en camino
      </h2>
      <p class="mt-3 text-ink-200 text-pretty">
        Estoy preparando contenido sobre Android, Java/Spring, freelancing en España y desarrollo de plugins.
      </p>
      <a href="/blog" class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-coral hover:text-coral-300 transition-colors">
        Suscríbete para enterarte
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
