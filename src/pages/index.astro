---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site';

const services = site.services.slice(0, 3);
const featuredPlugins = site.plugins.slice(0, 4);
---

<BaseLayout
  title={site.tagline}
  description={site.bio}
  type="profile"
>
  <!-- HERO -->
  <section class="container-page pt-12 sm:pt-20 pb-12 sm:pb-16">
    <div class="max-w-4xl">
      <p class="text-sm font-medium text-sage-500 mb-3 fade-in-up">
        📍 {site.location}, {site.country}
      </p>
      <h1 class="font-display font-bold text-4xl sm:text-5xl md:text-6xl text-ink-300 text-balance leading-tight fade-in-up stagger-1">
        {site.tagline}
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ink-200 max-w-2xl text-pretty fade-in-up stagger-2">
        {site.bio}
      </p>
      <div class="mt-8 flex flex-wrap gap-3 fade-in-up stagger-3">
        <a
          href="/contacto"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-300 text-ink-300 font-semibold hover:bg-amber-400 transition-all shadow-md shadow-amber-300/30"
        >
          Hablemos de tu proyecto
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a
          href="/perfil"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-cream-100 text-ink-300 font-semibold border-2 border-sage-100 hover:border-sage-300 transition-all"
        >
          Ver perfil profesional
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT ME CORTO -->
  <section class="container-page py-12 sm:py-16 border-t border-sage-100">
    <div class="grid md:grid-cols-3 gap-6 sm:gap-10">
      <div class="md:col-span-1">
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-ink-300 text-balance">
          Quién soy
        </h2>
        <a href="/sobre-mi" class="inline-block mt-3 text-sm font-medium text-sage-500 hover:text-sage-600 transition-colors">
          Leer más →
        </a>
      </div>
      <div class="md:col-span-2 space-y-4 text-ink-200 text-pretty leading-relaxed">
        <p>
          <strong class="text-ink-300">Nacido en Perú, viviendo en Jaén, España.</strong> Más de 9 años construyendo software — empecé en Android, me especialicé en backend con Java/Spring, y ahora combino ambos mundos con infraestructura cloud.
        </p>
        <p>
          Mi enfoque es pragmático: menos buzzwords, más producto funcionando. Disfruto tanto de una arquitectura limpia como de un hot fix que salva un deploy.
        </p>
        <p class="text-sm text-ink-100">
          🇵🇪 → 🇪🇸 · {site.role} · Disponible para remoto
        </p>
      </div>
    </div>
  </section>

  <!-- SERVICIOS PREVIEW -->
  <section class="container-page py-12 sm:py-16 border-t border-sage-100">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-ink-300 text-balance">
          Lo que hago
        </h2>
        <p class="mt-2 text-ink-200 text-pretty">
          5 servicios para cubrir cualquier proyecto tech.
        </p>
      </div>
      <a href="/servicios" class="hidden sm:inline text-sm font-medium text-sage-500 hover:text-sage-600">
        Ver los 5 →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {services.map((s, i) => (
        <a
          href={`/servicios/${s.slug}`}
          class="group p-6 bg-cream-100 rounded-2xl border-2 border-sage-100 hover:border-sage-300 hover:shadow-lg hover:shadow-sage-200/40 transition-all fade-in-up"
          style={`animation-delay: ${0.05 * (i + 1)}s`}
        >
          <div class="w-12 h-12 rounded-xl bg-sage-50 flex items-center justify-center mb-4 group-hover:bg-sage-100 transition-colors">
            <span class="text-2xl">
              {s.icon === 'web' ? '🌐' : s.icon === 'mobile' ? '📱' : s.icon === 'stack' ? '🏗️' : s.icon === 'wrench' ? '🔧' : '✨'}
            </span>
          </div>
          <h3 class="font-display font-bold text-lg text-ink-300 mb-2">{s.name}</h3>
          <p class="text-sm text-ink-200 text-pretty leading-relaxed">{s.tagline}</p>
          <p class="mt-4 text-sm font-medium text-sage-500 group-hover:translate-x-1 transition-transform inline-block">
            Ver detalles →
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- PLUGINS PREVIEW -->
  <section class="container-page py-12 sm:py-16 border-t border-sage-100">
    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="inline-block px-2.5 py-0.5 rounded-full bg-sage-100 text-sage-600 text-xs font-semibold mb-2">
          🐯 Tiger Suite
        </div>
        <h2 class="font-display font-bold text-2xl sm:text-3xl text-ink-300 text-balance">
          5 plugins open source para PrestaShop
        </h2>
        <p class="mt-2 text-ink-200 text-pretty">
          Marketing suite completa. Alternativa a los €200/mes europeos.
        </p>
      </div>
      <a href="/plugins" class="hidden sm:inline text-sm font-medium text-sage-500 hover:text-sage-600">
        Ver la suite →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
      {featuredPlugins.map((p, i) => (
        <a
          href={`/plugins/${p.slug}`}
          class="group p-5 bg-gradient-to-br from-cream-100 to-sage-50 rounded-2xl border-2 border-sage-100 hover:border-sage-300 transition-all fade-in-up"
          style={`animation-delay: ${0.05 * (i + 1)}s`}
        >
          <div class="text-3xl mb-2">{p.icon}</div>
          <h3 class="font-display font-bold text-base text-ink-300 mb-1">{p.name.replace('Tiger ', '')}</h3>
          <p class="text-sm text-ink-200 text-pretty leading-relaxed line-clamp-2">{p.tagline}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- BLOG PREVIEW (próximamente) -->
  <section class="container-page py-12 sm:py-16 border-t border-sage-100">
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-block px-3 py-1 rounded-full bg-amber-100 text-amber-500 text-xs font-semibold mb-3">
        Próximamente
      </div>
      <h2 class="font-display font-bold text-2xl sm:text-3xl text-ink-300 text-balance">
        Blog
      </h2>
      <p class="mt-3 text-ink-200 text-pretty">
        Estoy preparando contenido sobre Android, Java/Spring, freelancing en España y desarrollo de plugins.
      </p>
      <a href="/blog" class="inline-block mt-5 text-sm font-medium text-sage-500 hover:text-sage-600">
        Suscríbete para enterarte →
      </a>
    </div>
  </section>
</BaseLayout>
