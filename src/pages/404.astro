---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 · Página no encontrada"
  description="La página que buscas no existe."
>
  <main class="container-page flex flex-col items-center justify-center min-h-screen text-center pb-6">
    <div class="fade-in-up">
      <p class="font-display font-bold text-7xl sm:text-8xl text-sage-300 mb-4">404</p>
      <h1 class="font-display font-bold text-2xl sm:text-3xl text-ink-300 text-balance mb-3">
        Página no encontrada
      </h1>
      <p class="text-ink-100 text-pretty max-w-sm mx-auto mb-8">
        La página que buscas no existe o se ha movido. Vuelve al inicio y explora.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-300 text-ink-300 font-semibold hover:bg-amber-400 tap-feedback transition-all shadow-md shadow-amber-300/30"
      >
        Volver al inicio
      </a>
    </div>
  </main>
</BaseLayout>
