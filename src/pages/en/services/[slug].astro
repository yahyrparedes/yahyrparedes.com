---
import ServiceDetailPage from '@components/pages/ServiceDetailPage.astro';
import { services, type ServiceDetail } from '@data/services.ts';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: ServiceDetail };
---

<ServiceDetailPage service={service} />
