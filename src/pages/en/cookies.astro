---
import BaseLayout from '@layouts/BaseLayout.astro';
import { t, getLangFromUrl } from '@i18n/ui.ts';

const currentLang = getLangFromUrl(Astro.url);
---

<BaseLayout
  title="Cookie Policy · Yahyr Paredes"
  description="Information about the use of cookies on yahyrparedes.com."
>
  <article class="container-page py-12 sm:py-16 max-w-3xl">
    <header class="mb-10">
      <p class="eyebrow mb-3">LEGAL</p>
      <h1 class="text-balance">Cookie Policy</h1>
      <p class="mt-3 text-ink-200 text-sm">Last updated: July 2026</p>
    </header>

    <div class="prose prose-invert max-w-none space-y-6 text-ink-100 leading-relaxed">
      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">1. What are cookies?</h2>
        <p>
          Cookies are small files that websites store on your device to remember information between visits.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">2. Cookies used by this site</h2>
        <p>
          <strong>yahyrparedes.com does not use tracking, analytics or marketing cookies.</strong>
        </p>
        <p>
          If I ever add any, I will update this policy and notify you with a consent banner. Until then, this site is 100% cookie-free regarding tracking.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">3. Technical cookies that may exist</h2>
        <p>
          The web server or hosting provider (Coolify) may use strictly necessary technical cookies for the site to function (for example, HTTPS session). These do not require consent under current regulations.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">4. How to manage cookies</h2>
        <p>
          Although this site does not use advertising or analytics cookies, you can configure your browser to block or delete any cookies. Check your browser's help for more information.
        </p>
      </section>
    </div>

    <div class="mt-12 pt-6 border-t border-border">
      <a href={currentLang === 'en' ? '/en/' : '/es/'} class="text-blue-200 hover:text-blue transition-colors inline-flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to home
      </a>
    </div>
  </article>
</BaseLayout>
