---
// Página placeholder para /en/open-source/[slug].
// El contenido detallado solo existe en español por ahora,
// así que cada ruta EN redirige a su equivalente ES.
import { site } from '@data/site.ts';

export async function getStaticPaths() {
  return site.plugins.map((p) => ({
    params: { slug: p.slug },
    redirect: `/es/open-source/${p.slug}/`,
  }));
}
---
