---
import BaseLayout from '@layouts/BaseLayout.astro';
import { t, getLangFromUrl } from '@i18n/ui.ts';
---

<BaseLayout title={`500 · Yahyr Paredes`} description={t(Astro.url, '500.body')} noindex={true}>
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
    <!-- Decorative background with smoke -->
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-coral/5 blur-3xl"></div>
      <div class="absolute top-1/4 right-1/4 w-32 h-32 rounded-full bg-ink-300/10 blur-2xl"></div>
      <div class="absolute bottom-1/3 right-1/3 w-48 h-48 rounded-full bg-ink-300/5 blur-3xl"></div>
    </div>

    <div class="container-page text-center">
      <h1 class="font-display font-bold text-[10rem] sm:text-[14rem] leading-none text-ink tracking-tighter">
        {t(Astro.url, '500.code')}
      </h1>
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-ink mt-4">
        {t(Astro.url, '500.title')}
      </h2>
      <p class="text-ink-200 text-lg mt-4 max-w-md mx-auto">
        {t(Astro.url, '500.body')}
      </p>

      <!-- Cohete estrellado (placeholder SVG) -->
      <div class="my-12 flex justify-center">
        <svg width="200" height="200" viewBox="0 0 200 200" fill="none" class="text-orange opacity-60" aria-hidden="true">
          <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" opacity="0.4" />
          <path d="M100 50 L110 90 L130 110 L110 130 L100 150 L90 130 L70 110 L90 90 Z" fill="currentColor" opacity="0.6" />
          <circle cx="100" cy="105" r="6" fill="currentColor" opacity="0.9" />
          <path d="M75 75 L85 85 M125 75 L115 85 M75 135 L85 125 M125 135 L115 125" stroke="currentColor" stroke-width="2" />
          <path d="M60 160 L70 165 L65 170" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M140 160 L130 165 L135 170" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </div>

      <div class="flex items-center justify-center gap-3">
        <a
          href={getLangFromUrl(Astro.url) === 'en' ? '/en/' : '/es/'}
          class="btn btn-primary"
        >
          {t(Astro.url, '500.cta')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a
          href={getLangFromUrl(Astro.url) === 'en' ? '/en/contact' : '/es/contacto'}
          class="btn btn-outline"
        >
          {t(Astro.url, '500.contact_me')}
        </a>
      </div>

      <div class="mt-12 text-sm text-ink-200">
        <p class="font-display italic">{t(Astro.url, '500.issues_title')}</p>
      </div>
    </div>
  </section>
</BaseLayout>
