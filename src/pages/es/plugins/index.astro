---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site.ts';
import { productJsonLd } from '@lib/seo.ts';

const jsonLd = site.plugins.map((p) => productJsonLd({
  name: p.name, description: p.description, price: p.price, priceUnit: p.priceUnit, platform: p.platform,
}));
---

<BaseLayout
  title="Tiger — Suite de marketing para PrestaShop"
  description="5 módulos open source para tu tienda PrestaShop. Google Shopping, Rich Snippets, Pixel Suite, Meta Shop y Search Console. La alternativa a los módulos europeos de 200€/mes."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="bg-hero container-page py-12 sm:py-16 max-w-6xl">
    <!-- Hero suite -->
    <header class="text-center mb-16 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue/10 border border-blue/30 text-blue-200 text-xs font-semibold mb-4">
        🐯 Tiger Suite · Open Source
      </div>
      <h1 class="font-display font-bold text-4xl sm:text-5xl md:text-6xl text-ink text-balance">
        Suite de marketing para PrestaShop
      </h1>
      <p class="mt-5 text-lg sm:text-xl text-ink-200 text-pretty">
        La alternativa open source a los módulos europeos de 200€/mes.
        <br class="hidden sm:block" />
        Hechos en LATAM, para LATAM.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm text-ink-100">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-midnight-100 border border-border">
          ✓ 5 módulos independientes
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-midnight-100 border border-border">
          ✓ MIT License
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-midnight-100 border border-border">
          ✓ Sin telemetría
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-midnight-100 border border-border">
          ✓ Sin lock-in
        </span>
      </div>
    </header>

    <!-- The 5 modules -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {site.plugins.map((p, i) => (
        <a
          href={`/es/plugins/${p.slug}`}
          class="group card p-6 sm:p-7 flex flex-col hover:border-blue/30"
        >
          <div class="flex items-start justify-between mb-4">
            <span class="text-4xl" aria-hidden="true">{p.icon}</span>
            <span class="text-xs font-mono text-ink-200 bg-midnight-200 px-2 py-0.5 rounded border border-border">
              {p.slug.replace('-', '_').toUpperCase()}
            </span>
          </div>
          <h2 class="font-display font-bold text-lg text-ink mb-2">{p.name}</h2>
          <p class="text-sm text-ink-200 text-pretty leading-relaxed flex-1">{p.tagline}</p>
          <div class="mt-5 flex items-center justify-between text-xs">
            <span class="font-semibold text-blue-200">{p.price}</span>
            <span class="text-ink-300">{p.platform} {p.version}</span>
          </div>
          <p class="mt-4 text-sm font-medium text-blue-200 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
            Ver módulo
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </p>
        </a>
      ))}
    </div>

    <!-- Why Tiger -->
    <section class="mt-20">
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-ink text-balance text-center mb-10">
        Por qué Tiger
      </h2>
      <div class="grid sm:grid-cols-3 gap-4 sm:gap-6">
        <div class="card p-6">
          <div class="text-3xl mb-3">💸</div>
          <h3 class="font-display font-bold text-lg text-ink mb-2">0€ vs 200€/mes</h3>
          <p class="text-ink-200 text-pretty">
            Los módulos europeos cuestan entre 150€ y 300€ al mes. Para una tienda LATAM con 200 a 2000 productos, es inviable. Tiger es open source y no tiene costes ocultos.
          </p>
        </div>
        <div class="card p-6">
          <div class="text-3xl mb-3">🔌</div>
          <h3 class="font-display font-bold text-lg text-ink mb-2">Independientes</h3>
          <p class="text-ink-200 text-pretty">
            5 módulos independientes. Instala solo lo que necesitas. Funcionan por separado, sin dependencias entre sí.
          </p>
        </div>
        <div class="card p-6">
          <div class="text-3xl mb-3">🌎</div>
          <h3 class="font-display font-bold text-lg text-ink mb-2">LATAM primero</h3>
          <p class="text-ink-200 text-pretty">
            Hechos por desarrolladores que entienden el mercado LATAM: multi-moneda, multi-idioma y multi-país de verdad. No traducción automática.
          </p>
        </div>
      </div>
    </section>

    <!-- Open source vs Pro -->
    <section class="mt-20 card p-6 sm:p-10">
      <h2 class="font-display font-bold text-2xl sm:text-3xl text-ink text-balance mb-2 text-center">
        Hoy gratis. Pronto, Pro para quienes quieran soporte.
      </h2>
      <p class="text-ink-200 text-pretty text-center max-w-2xl mx-auto mb-8">
        Todos los módulos son open source con licencia MIT y siempre lo serán. Lo que viene es opcional, para quien quiera soporte profesional.
      </p>
      <div class="grid sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
        <div class="p-5 bg-midnight-100 rounded-xl border-2 border-border">
          <div class="text-xs font-bold text-blue-200 uppercase tracking-wider mb-2">Open Source</div>
          <p class="text-2xl font-display font-bold text-ink mb-3">Gratis</p>
          <ul class="space-y-2 text-sm text-ink-200">
            <li class="flex items-start gap-2"><span class="text-blue-200">✓</span> Todos los módulos en GitHub</li>
            <li class="flex items-start gap-2"><span class="text-blue-200">✓</span> Sin límites de uso</li>
            <li class="flex items-start gap-2"><span class="text-blue-200">✓</span> Soporte de la comunidad</li>
          </ul>
        </div>
        <div class="p-5 bg-orange/10 rounded-xl border-2 border-orange/30 relative">
          <span class="absolute top-2 right-2 text-xs font-bold text-orange bg-midnight px-2 py-0.5 rounded-full border border-orange/30">PRONTO</span>
          <div class="text-xs font-bold text-orange uppercase tracking-wider mb-2">Pro</div>
          <p class="text-2xl font-display font-bold text-ink mb-3">29€<span class="text-sm text-ink-200 font-normal">/mes por tienda</span></p>
          <ul class="space-y-2 text-sm text-ink-200">
            <li class="flex items-start gap-2"><span class="text-orange">✓</span> Soporte email prioritario</li>
            <li class="flex items-start gap-2"><span class="text-orange">✓</span> Backups de configuración</li>
            <li class="flex items-start gap-2"><span class="text-orange">✓</span> Onboarding asistido</li>
            <li class="flex items-start gap-2"><span class="text-orange">✓</span> Instalación incluida</li>
          </ul>
        </div>
      </div>
    </section>

    <div class="mt-16 text-center">
      <a
        href="https://github.com/yahyrparedes"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        Ver en GitHub
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
    </div>
  </article>
</BaseLayout>
