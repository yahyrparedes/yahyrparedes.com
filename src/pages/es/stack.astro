---
import BaseLayout from '@layouts/BaseLayout.astro';

const capabilities = [
  {
    icon: 'mobile',
    title: 'Mobile',
    description: 'Android nativo con Kotlin y Jetpack Compose. iOS con Swift. Multiplataforma con Flutter y Kotlin Multiplatform cuando tiene sentido para el producto.',
    technologies: ['Kotlin', 'Jetpack Compose', 'Swift', 'SwiftUI', 'Flutter', 'KMP', 'Coroutines', 'Room', 'Retrofit'],
  },
  {
    icon: 'backend',
    title: 'Backend',
    description: 'Java + Spring Boot es mi stack principal. También trabajo con Node.js, Python/Django y PHP/Laravel. PostgreSQL, MySQL y MongoDB.',
    technologies: ['Java', 'Spring Boot', 'Node.js', 'Python', 'PHP', 'Laravel', 'PostgreSQL', 'MySQL', 'MongoDB'],
  },
  {
    icon: 'cloud',
    title: 'Cloud & DevOps',
    description: 'AWS (Lambda, Cognito, CDK, S3) y GCP (Cloud Run, Firebase). Docker, GitHub Actions, Nginx. Self-hosted con Coolify + Cloudflare.',
    technologies: ['AWS Lambda', 'GCP Cloud Run', 'Docker', 'GitHub Actions', 'Nginx', 'Coolify', 'Cloudflare'],
  },
  {
    icon: 'architecture',
    title: 'Arquitectura',
    description: 'Clean Architecture, DDD, Hexagonal, CQRS. Diseño sistemas que escalan y sobreviven a cambios de equipo.',
    technologies: ['Clean Architecture', 'DDD', 'Hexagonal', 'CQRS', 'Event-Driven', 'Microservices', 'MVI'],
  },
];
---

<BaseLayout
  title="Stack · Yahyr Paredes"
  description="Tecnologías y patrones que uso para construir productos escalables."
>
  <!-- HERO -->
  <section class="container-page pt-16 sm:pt-20 pb-12">
    <p class="eyebrow mb-5">STACK</p>
    <h1 class="text-balance max-w-3xl mb-6">
      Tecnologías y patrones<br />
      para construir <span class="text-blue-200 font-display italic font-medium">productos que escalan</span>.
    </h1>
    <p class="text-ink-100 text-lg max-w-2xl leading-relaxed">
      No persigo tendencias. Elijo herramientas que resuelven problemas reales y sobreviven a cambios de equipo. Esto es lo que uso en el día a día.
    </p>
  </section>

  <!-- CAPABILITIES (4 cards) -->
  <section class="container-page pb-16 sm:pb-24">
    <div class="grid sm:grid-cols-2 gap-5 sm:gap-6">
      {capabilities.map((cap) => (
        <article class="card-glass p-6 sm:p-8 group hover:border-blue/30">
          <!-- Icon -->
          <div class="w-14 h-14 rounded-2xl bg-blue/10 border border-blue/20 flex items-center justify-center mb-5 group-hover:bg-blue/20 transition-colors">
            {cap.icon === 'mobile' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-blue-200" aria-hidden="true">
                <rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/><path d="M9 5h6"/>
              </svg>
            )}
            {cap.icon === 'backend' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-blue-200" aria-hidden="true">
                <path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/><path d="M3 18l9 5 9-5"/>
              </svg>
            )}
            {cap.icon === 'cloud' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-blue-200" aria-hidden="true">
                <path d="M18 10h-1.26A8 8 0 109 20h9a5 5 0 000-10z"/>
              </svg>
            )}
            {cap.icon === 'architecture' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-blue-200" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
              </svg>
            )}
          </div>

          <h2 class="font-display font-bold text-2xl text-ink mb-3">{cap.title}</h2>
          <p class="text-ink-200 leading-relaxed mb-5">{cap.description}</p>

          <p class="text-xs text-ink-300 uppercase tracking-wider mb-2">Tecnologías</p>
          <div class="flex flex-wrap gap-1.5">
            {cap.technologies.map((tech) => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-midnight-200 text-ink-200 border border-border">
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-border">
    <div class="container-page py-12 sm:py-16">
      <div class="closing-panel card-glass p-8 sm:p-10 text-center">
        <p class="font-display italic text-2xl text-ink mb-3">
          Las herramientas son medios. El producto es el fin.
        </p>
        <p class="text-ink-200 mb-6 max-w-xl mx-auto">
          Elijo la herramienta adecuada para el problema. Si tu proyecto necesita algo fuera de mi stack, lo aprendo.
        </p>
        <a
          href={Astro.url.pathname.startsWith('/en/') ? '/en/contact' : '/es/contacto'}
          class="btn btn-primary"
        >
          Hablemos de tu proyecto
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
