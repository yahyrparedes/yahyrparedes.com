---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Writing · Yahyr Paredes"
  description="Artículos y notas técnicas sobre product engineering, mobile, backend y sistemas en producción."
>
  <section class="hero-editorial relative overflow-hidden">
    <div class="container-page relative py-20 sm:py-28">
      <p class="eyebrow mb-5">WRITING</p>
      <h1 class="text-balance max-w-3xl mb-6">
        Ideas sobre producto, ingeniería y sistemas que duran.
      </h1>
      <p class="text-ink-100 text-lg max-w-2xl leading-relaxed">
        Estoy preparando artículos prácticos sobre mobile, backend, arquitectura, trabajo remoto y construcción de productos en producción.
      </p>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="card-glass p-8 sm:p-10">
      <p class="eyebrow mb-4">PRÓXIMAMENTE</p>
      <div class="grid lg:grid-cols-12 gap-8">
        <div class="lg:col-span-5">
          <h2 class="text-balance mb-4">Writing, no blog por publicar ruido.</h2>
          <p class="text-ink-200 leading-relaxed">
            La sección se abrirá con piezas útiles y verificables: decisiones técnicas, aprendizajes de producto y casos reales.
          </p>
        </div>
        <div class="lg:col-span-7 grid sm:grid-cols-2 gap-3">
          {['Arquitectura mobile que escala', 'Backend pragmático en producción', 'Lecciones de producto en startups', 'Cómo trabajo con AI sin perder criterio'].map((topic) => (
            <div class="rounded-xl border border-border bg-white/5 p-4">
              <p class="text-sm font-semibold text-ink">{topic}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
