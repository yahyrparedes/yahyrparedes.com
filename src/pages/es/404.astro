---
import BaseLayout from '@layouts/BaseLayout.astro';
import { t, getLangFromUrl } from '@i18n/ui.ts';
---

<BaseLayout title={`404 · Yahyr Paredes`} description={t(Astro.url, '404.body')} noindex={true}>
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
    <!-- Decorative background -->
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-blue/5 blur-3xl"></div>
      <div class="absolute top-1/3 right-1/4 w-2 h-2 rounded-full bg-ink opacity-40"></div>
      <div class="absolute top-1/2 right-1/3 w-1 h-1 rounded-full bg-ink opacity-30"></div>
      <div class="absolute bottom-1/3 left-1/3 w-1.5 h-1.5 rounded-full bg-ink opacity-30"></div>
    </div>

    <div class="container-page text-center">
      <h1 class="font-display font-bold text-[10rem] sm:text-[14rem] leading-none text-ink tracking-tighter">
        {t(Astro.url, '404.code')}
      </h1>
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-ink mt-4">
        {t(Astro.url, '404.title')}
      </h2>
      <p class="text-ink-200 text-lg mt-4 max-w-md mx-auto">
        {t(Astro.url, '404.body')}
      </p>

      <!-- Astronauta (placeholder SVG) -->
      <div class="my-12 flex justify-center">
        <svg width="200" height="200" viewBox="0 0 200 200" fill="none" class="text-blue-200 opacity-60" aria-hidden="true">
          <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" />
          <circle cx="100" cy="100" r="40" stroke="currentColor" stroke-width="1" />
          <path d="M60 100 Q100 60 140 100" stroke="currentColor" stroke-width="1" />
          <path d="M60 100 Q100 140 140 100" stroke="currentColor" stroke-width="1" />
          <circle cx="100" cy="100" r="3" fill="currentColor" />
          <path d="M85 75 L115 75 M85 125 L115 125" stroke="currentColor" stroke-width="1" />
        </svg>
      </div>

      <a
        href={getLangFromUrl(Astro.url) === 'en' ? '/en/' : '/es/'}
        class="btn btn-primary"
      >
        {t(Astro.url, '404.cta')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      <div class="mt-12 text-sm text-ink-200">
        <p class="font-display italic mb-2">{t(Astro.url, '404.lost_title')}</p>
        <p class="text-ink-300">{t(Astro.url, '404.lost_links')}</p>
      </div>
    </div>
  </section>
</BaseLayout>
