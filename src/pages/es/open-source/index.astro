---
import BaseLayout from '@layouts/BaseLayout.astro';

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Flow-GM',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS',
  description:
    'Flow-GM es un CRM local para creadores que organizan colaboraciones con marcas, mensajes, productos y calendario de contenido desde su Mac.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
};
---

<BaseLayout
  title="Open Source y herramientas · Yahyr Paredes"
  description="Herramientas, extensiones y productos de libre uso creados por Yahyr Paredes. Flow-GM es un CRM local para gestionar colaboraciones entre creadores y marcas."
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />

  <article class="container-page py-12 sm:py-16 max-w-6xl">
    <header class="mb-12 sm:mb-16 max-w-3xl">
      <p class="section-kicker">OPEN SOURCE</p>
      <h1 class="mt-4 font-display font-bold text-4xl sm:text-5xl md:text-6xl text-ink text-balance">
        Herramientas pequeñas para problemas reales.
      </h1>
      <p class="mt-5 text-lg sm:text-xl text-ink-200 text-pretty">
        Productos, extensiones y módulos creados desde necesidades concretas: ordenar trabajo,
        reducir fricción y mantener control sobre los datos.
      </p>
    </header>

    <div class="grid lg:grid-cols-[1.35fr_0.65fr] gap-6">
      <a href="/es/open-source/flow-gm/" class="group card-glass p-6 sm:p-8 overflow-hidden hover:border-blue/35">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <span class="inline-flex items-center rounded-full border border-blue/30 bg-blue/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.2em] text-blue-200">
              Nuevo producto
            </span>
            <h2 class="mt-5 font-display text-3xl sm:text-4xl font-bold text-ink">Flow-GM</h2>
            <p class="mt-3 text-xl text-ink text-balance">
              Tus colaboraciones, ordenadas y bajo tu control.
            </p>
          </div>
          <span class="rounded-full border border-border bg-white/5 px-3 py-1 text-xs font-mono text-ink-200">
            macOS · SQLite · Local
          </span>
        </div>

        <p class="mt-6 max-w-2xl text-ink-200 leading-relaxed text-pretty">
          Mini CRM local para creadores, Amazon Influencers y pequeños equipos que necesitan
          registrar marcas, productos, conversaciones y contenido sin depender de una plataforma
          en la nube.
        </p>

        <div class="mt-8 grid sm:grid-cols-3 gap-3">
          {['CRM de colaboraciones', 'Prevención de duplicados', 'Calendario de contenido'].map((item) => (
            <div class="rounded-lg border border-border bg-midnight-100/70 px-4 py-3 text-sm font-semibold text-ink">
              {item}
            </div>
          ))}
        </div>

        <p class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-blue-200 transition-transform group-hover:translate-x-1">
          Ver Flow-GM
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </p>
      </a>

      <aside class="card-glass p-6 sm:p-7">
        <p class="section-kicker">HERRAMIENTAS EXTRAS</p>
        <h2 class="mt-4 font-display text-2xl font-bold text-ink">Open source sin ruido.</h2>
        <p class="mt-4 text-ink-200 leading-relaxed text-pretty">
          Esta sección agrupa productos de libre uso y utilidades propias. Los módulos Tiger para
          PrestaShop quedan ocultos del índice por ahora mientras reorganizo la colección.
        </p>
        <div class="mt-6 rounded-lg border border-border bg-white/5 p-4">
          <p class="text-sm font-semibold text-ink">Privacidad por defecto</p>
          <p class="mt-2 text-sm text-ink-200 leading-relaxed">
            Flow-GM prioriza datos locales, exportación JSON y uso sin cuenta obligatoria.
          </p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
