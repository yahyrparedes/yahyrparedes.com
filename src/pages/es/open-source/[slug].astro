---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site.ts';
import { productJsonLd } from '@lib/seo.ts';

export async function getStaticPaths() {
  return site.plugins.map((p) => ({
    params: { slug: p.slug },
    props: { plugin: p },
  }));
}

const { plugin } = Astro.props;
const jsonLd = productJsonLd({
  name: plugin.name, description: plugin.description, price: plugin.price, priceUnit: plugin.priceUnit, platform: plugin.platform,
});
---

<BaseLayout
  title={`${plugin.name} · Módulo SEO ${plugin.platform}`}
  description={plugin.tagline}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="container-page py-12 sm:py-16 max-w-4xl">
    <nav class="text-sm text-ink-100 mb-6 fade-in-up" aria-label="Breadcrumb">
      <a href="/es/" class="hover:text-ink-300">Inicio</a>
      <span class="mx-2">/</span>
      <a href="/es/open-source/" class="hover:text-ink-300">Open Source</a>
      <span class="mx-2">/</span>
      <span class="text-ink-300">{plugin.name}</span>
    </nav>

    <header class="hero-editorial relative overflow-hidden -mx-6 sm:-mx-8 mb-10 rounded-2xl border border-border p-6 sm:p-10 fade-in-up stagger-1">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-blue/10 text-blue-200 uppercase tracking-wide border border-blue/30">
          {plugin.platform}
        </span>
        <span class="text-xs text-ink-100">v{plugin.version}</span>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-orange/10 text-orange border border-orange/30">
          {plugin.status === 'available' ? '✓ Disponible' : plugin.status === 'beta' ? '🧪 Beta' : '🔜 Roadmap'}
        </span>
      </div>
      <h1 class="font-display font-bold text-4xl sm:text-5xl text-ink text-balance">
        {plugin.name}
      </h1>
      <p class="mt-3 text-xl text-ink-200 text-pretty">{plugin.tagline}</p>
    </header>

    <div class="space-y-12 fade-in-up stagger-2">
      <!-- Hero description -->
      <section>
        <p class="text-lg text-ink-200 leading-relaxed text-pretty">{plugin.longDescription}</p>
      </section>

      <!-- Pricing card -->
      <section id="buy" class="p-6 sm:p-8 closing-panel card-glass">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="text-sm font-medium text-ink-100 mb-1">Licencia anual</p>
            <p class="text-4xl font-display font-bold text-ink">{plugin.price}€</p>
            <p class="text-sm text-ink-200 mt-1">{plugin.priceUnit}</p>
          </div>
          <a
            href={plugin.buyUrl}
            class="btn btn-primary"
          >
            Comprar ahora
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        {plugin.demoUrl && (
          <a href={plugin.demoUrl} class="inline-block mt-4 text-sm text-blue-200 hover:text-blue">
            Ver demo en vivo →
          </a>
        )}
      </section>

      <!-- Features -->
      <section>
        <h2 class="font-display font-bold text-2xl text-ink-300 mb-4">Qué hace</h2>
        <ul class="space-y-2.5">
          {plugin.features.map((f) => (
            <li class="flex items-start gap-3">
              <span class="text-blue-200 mt-0.5">✓</span>
              <span class="text-ink-200">{f}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Benefits -->
      <section>
        <h2 class="font-display font-bold text-2xl text-ink-300 mb-4">Por qué lo necesitas</h2>
        <ul class="space-y-2.5">
          {plugin.benefits.map((b) => (
            <li class="flex items-start gap-3 p-3 rounded-lg border border-border bg-white/5">
              <span class="text-blue-200 mt-0.5">→</span>
              <span class="text-ink-200">{b}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Use cases -->
      <section>
        <h2 class="font-display font-bold text-2xl text-ink-300 mb-4">Casos de uso</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {plugin.useCases.map((uc) => (
            <div class="p-4 card-glass">
              <p class="text-ink-200 text-pretty">{uc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Install -->
      <section>
        <h2 class="font-display font-bold text-2xl text-ink-300 mb-4">Cómo se instala</h2>
        <ol class="space-y-3">
          {plugin.installSteps.map((step, i) => (
            <li class="flex items-start gap-3">
              <span class="flex-shrink-0 w-7 h-7 rounded-full bg-blue text-white text-sm font-bold flex items-center justify-center">
                {i + 1}
              </span>
              <span class="text-ink-200 flex-1 pt-0.5">{step}</span>
            </li>
          ))}
        </ol>
      </section>

      <!-- FAQ -->
      <section>
        <h2 class="font-display font-bold text-2xl text-ink-300 mb-6">FAQ</h2>
        <div class="space-y-4">
          {plugin.faq.map((q) => (
            <details class="group p-5 card-glass">
              <summary class="font-semibold text-ink cursor-pointer flex items-center justify-between">
                {q.question}
                <svg class="w-5 h-5 text-ink-100 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p class="mt-3 text-ink-200 text-pretty">{q.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <div class="pt-8 text-center">
        <a
          href={plugin.buyUrl}
          class="btn btn-primary"
        >
          Comprar {plugin.name} por {plugin.price}€
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
