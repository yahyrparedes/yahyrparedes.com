---
import BaseLayout from '@layouts/BaseLayout.astro';
import { t, getLangFromUrl } from '@i18n/ui.ts';

const currentLang = getLangFromUrl(Astro.url);
---

<BaseLayout
  title="Política de Privacidad · Yahyr Paredes"
  description="Cómo recojo, uso y protejo tus datos personales en yahyrparedes.com."
>
  <article class="container-page py-12 sm:py-16 max-w-3xl">
    <header class="mb-10">
      <p class="eyebrow mb-3">LEGAL</p>
      <h1 class="text-balance">Política de Privacidad</h1>
      <p class="mt-3 text-ink-200 text-sm">Última actualización: julio 2026</p>
    </header>

    <div class="prose prose-invert max-w-none space-y-6 text-ink-100 leading-relaxed">
      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">1. Responsable del tratamiento</h2>
        <p>
          Yahyr Paredes, con email de contacto <a href="mailto:hola@yahyrparedes.com" class="text-blue-200 hover:text-blue transition-colors">hola@yahyrparedes.com</a>,
          es el responsable del tratamiento de los datos personales recogidos en este sitio web.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">2. Qué datos recojo</h2>
        <p>A través del formulario de contacto recojo:</p>
        <ul class="list-disc list-inside space-y-1 mt-2 text-ink-200">
          <li>Nombre</li>
          <li>Email</li>
          <li>Empresa (opcional)</li>
          <li>Mensaje libre</li>
        </ul>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">3. Con qué finalidad</h2>
        <p>
          Los datos se usan exclusivamente para responder a tu consulta o propuesta. No los vendo, no los comparto con terceros, no los uso para newsletter ni marketing sin tu consentimiento explícito.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">4. Conservación</h2>
        <p>
          Conservo los datos el tiempo necesario para responder a tu consulta y, si hay relación profesional posterior, durante la vigencia de la relación. Pasado ese periodo, los borro.
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">5. Tus derechos</h2>
        <p>
          Puedes ejercer tus derechos de acceso, rectificación, supresión, oposición, limitación y portabilidad escribiéndome a <a href="mailto:hola@yahyrparedes.com" class="text-blue-200 hover:text-blue transition-colors">hola@yahyrparedes.com</a>.
          También puedes reclamar ante la Agencia Española de Protección de Datos (www.aepd.es).
        </p>
      </section>

      <section>
        <h2 class="font-display font-bold text-2xl text-ink mb-3">6. Cookies</h2>
        <p>
          Este sitio no usa cookies de tracking ni analítica invasiva. Si en algún momento las añado, actualizaré esta política y te avisaré con un banner.
        </p>
      </section>
    </div>

    <div class="mt-12 pt-6 border-t border-border">
      <a href={currentLang === 'en' ? '/en/' : '/es/'} class="text-blue-200 hover:text-blue transition-colors inline-flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Volver al inicio
      </a>
    </div>
  </article>
</BaseLayout>
